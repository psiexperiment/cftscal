'''
Defines generic objects that can be reused by paradigms

Every object here is configured from environment variables set by
whoever launches the experiment (cftscal's own plugins, or the CFTS
experiment launcher). Each object declares a `required_vars` attribute
listing the settings the experiment cannot run without. If one of those
is missing from the environment, initialization fails with an error
naming the environment variables that were expected, rather than
silently falling back to whatever default the GUI happens to show.

`required_vars` defaults to every setting the object knows how to read.
Paradigms that do not need a particular setting must say so explicitly.
For example, a paradigm that *creates* a microphone calibration cannot
also load one, so it overrides `required_vars` to drop 'calibration'
(see the mixins in `cftscal/paradigms/__init__.py`). Settings left out
of `required_vars` are still applied when the environment provides
them; they simply no longer raise an error when it does not.

Which calibration ended up being used is reported in a read-only
context item next to the object's other hardware settings, which also
lands in the saved data (see
`cftscal/paradigms/calibration_status.py`). Every other setting is
visible in its own widget; a calibration is not, and a channel that
never got one silently falls back to unity.
'''
import logging
log = logging.getLogger(__name__)

import functools
import re

from enaml.core.api import Conditional
from enaml.workbench.api import Extension
from enaml.workbench.core.api import Command

from psi.core.enaml.api import ExperimentManifest
from psi.context.api import BoolParameter, ContextRow, EnumParameter, Parameter
from psi.controller.api import (
    ContinuousInput, DecimateTo, ExperimentAction, IIRFilter, MUXOutput
)
from psi.paradigms.core.io_mixins import ChannelInput, ChannelInputManifest

from cftscal.objects import (
    generic_microphone_manager,
    input_manager,
    output_manager,
    measurement_microphone_manager,
    speaker_manager,
    starship_manager
)


from cftscal import util

from cftscal.paradigms.calibration_status import (
    CalibrationParameter, report_calibration
)

from cftscal.paradigms.env_vars import INPUT_VARS, read_env_vars

from cftscal.util import (
    # TODO: Deprecate this.
    list_connections,
    list_input_amplifier_connections,
    list_generic_microphone_connections,
    list_measurement_microphone_connections,
    list_speaker_connections,
    list_starship_connections,
)


def initialize_input(manifest_id, env_prefix, required_vars, event):
    context = event.workbench.get_plugin('psi.context')
    controller = event.workbench.get_plugin('psi.controller')

    env = read_env_vars(manifest_id, env_prefix, INPUT_VARS, required_vars)
    if (input_name := env['name']) is None:
        # The calibration item is left reporting "not configured".
        return

    item_input = context.get_item(manifest_id)
    # Quotes around the name are important!
    item_input.expression = f'"{input_name}"'
    item_input.editable = False

    if (gain := env['gain']) is not None:
        item_gain = context.get_item(f'{manifest_id}_gain')
        item_gain.set_value(gain)
        item_gain.editable = False

    calibration = None
    if (cal_str := env['calibration']) is not None:
        calibration = input_manager.from_string(cal_str)
        channel = controller.get_channel(f'hw_ai::{input_name}')
        channel.calibration = calibration.load()
    report_calibration(context, f'{manifest_id}_calibration', calibration)


enamldef Input(ExperimentManifest): manifest:
    '''
    Defines a generic input. The IO manifest will be scanned for all channels
    that are subclasses of `HardwareAIChannel`.

    Environment variables are also needed to configure the input. Here,
    <env_prefix> is set as an attribute on the manifest and <name> is the
    uppercased name of the input channel as identified in the IO manifest.

    <env_prefix>
        Indicates which input channel to use ('name' in `required_vars`).

    <env_prefix>_<name>_GAIN
        Indicates the current gain setting on the input amplifier ('gain'
        in `required_vars`).

    <env_prefix>_<name>
        A calibration string (provided by cftscal) that will load the
        correct calibration when passed to `input_manager.from_string`
        ('calibration' in `required_vars`).

    Set `required_vars` to the subset of ['name', 'gain', 'calibration']
    the experiment actually needs. Missing entries are still applied when
    present in the environment, but no longer raise an error when absent.

    Once successfully initialized, a continous input named `{id}`
    will be available for use by other plugins.
    '''

    id = 'input'
    title = manifest.id.capitalize().replace('_', ' ')
    attr env_prefix = 'CFTS_INPUT'
    attr required_vars = ['name'] + list(INPUT_VARS)

    Extension:
        id = manifest.id + '.commands'
        point = 'enaml.workbench.core.commands'

        Command:
            id = manifest.id + '.initialize_input_settings'
            handler = functools.partial(initialize_input, manifest.id,
                                        manifest.env_prefix,
                                        manifest.required_vars)

    Extension:
        id = manifest.id + '.actions'
        point = 'psi.controller.actions'

        ExperimentAction:
            event = 'plugins_started'
            command = manifest.id + '.initialize_input_settings'

    Extension:
        id = manifest.id + '.io'
        point = 'psi.controller.io'

        ContinuousInput:
            name = manifest.id
            source_name = 'hw_ai::' + getattr(C, manifest.id)
            source::
                channel.gain = getattr(C, f'{manifest.id}_gain')

    Extension:
        id = manifest.id + '.context'
        point = 'psi.context.items'

        ContextRow:
            fmt = [f'{manifest.title}', microphone, 'with', gain, 'dB gain']
            name = f'{manifest.id}_settings'
            group_name = 'hardware_settings'

            EnumParameter: microphone:
                name = manifest.id
                label = f'{manifest.title}'
                choices = {k: f'"{v}"' for k, v in util.list_inputs().items()}
                scope = 'experiment'

            Parameter: gain:
                name = f'{manifest.id}_gain'
                label = f'{manifest.title} gain (dB)'
                dtype = 'float64'
                default = 40
                scope = 'experiment'

        CalibrationParameter:
            name = f'{manifest.id}_calibration'
            label = f'{manifest.title} calibration'
            group_name = 'hardware_settings'


#: Environment variables read by `initialize_output`. Unlike an input,
#: an output has no gain setting.
OUTPUT_VARS = {
    'calibration': '{prefix}_{name}',
}


def initialize_output(manifest_id, env_prefix, required_vars, event):
    context = event.workbench.get_plugin('psi.context')
    controller = event.workbench.get_plugin('psi.controller')

    env = read_env_vars(manifest_id, env_prefix, OUTPUT_VARS, required_vars)
    if (output_name := env['name']) is None:
        # The calibration item is left reporting "not configured".
        return

    item_output = context.get_item(manifest_id)
    # Quotes around the name are important!
    item_output.expression = f'"{output_name}"'
    item_output.editable = False

    calibration = None
    if (cal_str := env['calibration']) is not None:
        calibration = output_manager.from_string(cal_str)
        channel = controller.get_channel(f'hw_ao::{output_name}')
        channel.calibration = calibration.load()
    report_calibration(context, f'{manifest_id}_calibration', calibration)


enamldef Output(ExperimentManifest): manifest:
    '''
    Defines a generic output. The IO manifest will be scanned for all channels
    that are subclasses of `HardwareAOChannel`.

    Environment variables are also needed to configure the input.

    <env_prefix>
        Indicates which output channel to use ('name' in `required_vars`).

    <env_prefix>_<name>
        A calibration string (provided by cftscal) that will load the correct
        calibration when passed to `output_manager.from_string`
        ('calibration' in `required_vars`).

    Set `required_vars` to the subset of ['name', 'calibration'] the
    experiment actually needs. Missing entries are still applied when
    present in the environment, but no longer raise an error when absent.

    Once successfully initialized, a continous input named `{id}`
    will be available for use by other plugins.
    '''

    id = 'output'
    title = manifest.id.capitalize().replace('_', ' ')
    attr env_prefix = 'CFTS_OUTPUT'
    attr required_vars = ['name'] + list(OUTPUT_VARS)

    Extension:
        id = manifest.id + '.commands'
        point = 'enaml.workbench.core.commands'

        Command:
            id = manifest.id + '.initialize_output_settings'
            handler = functools.partial(initialize_output, manifest.id,
                                        manifest.env_prefix,
                                        manifest.required_vars)

    Extension:
        id = manifest.id + '.actions'
        point = 'psi.controller.actions'

        ExperimentAction:
            event = 'plugins_started'
            command = manifest.id + '.initialize_output_settings'

    Extension:
        id = manifest.id + '.io'
        point = 'psi.controller.io'

        MUXOutput:
            name = f'{manifest.id}_output'
            target_name = 'hw_ao::' + getattr(C, manifest.id)

    Extension:
        id = manifest.id + '.context'
        point = 'psi.context.items'

        EnumParameter:
            name = manifest.id
            label = f'{manifest.title}'
            choices = {k: f'"{v}"' for k, v in util.list_outputs().items()}
            scope = 'experiment'
            group_name = 'hardware_settings'

        CalibrationParameter:
            name = f'{manifest.id}_calibration'
            label = f'{manifest.title} calibration'
            group_name = 'hardware_settings'


enamldef Speaker(Output): manifest:

    id = 'system_output'
    env_prefix = 'CFTS_SPEAKER'


#: Maps the `microphone_type` attribute on the `Microphone` manifest to
#: the manager that knows how to load that type of calibration.
MICROPHONE_MANAGERS = {
    'generic_microphone': generic_microphone_manager,
    'measurement_microphone': measurement_microphone_manager,
}


def initialize_microphone(manifest_id, microphone_type, env_prefix,
                          required_vars, event):
    context = event.workbench.get_plugin('psi.context')
    controller = event.workbench.get_plugin('psi.controller')

    try:
        manager = MICROPHONE_MANAGERS[microphone_type]
    except KeyError:
        valid = ', '.join(MICROPHONE_MANAGERS)
        raise ValueError(f'Unsupported microphone type "{microphone_type}". '
                         f'Valid types are: {valid}.') from None

    env = read_env_vars(manifest_id, env_prefix, INPUT_VARS, required_vars)
    if (input_name := env['name']) is None:
        # The calibration item is left reporting "not configured".
        return

    item_microphone = context.get_item(f'{manifest_id}_input')
    # Quotes around the name are important!
    item_microphone.expression = f'"{input_name}"'
    item_microphone.editable = False

    if (gain := env['gain']) is not None:
        item_gain = context.get_item(f'{manifest_id}_input_gain')
        item_gain.set_value(gain)
        item_gain.editable = False

    calibration = None
    if (cal_str := env['calibration']) is not None:
        calibration = manager.from_string(cal_str)
        channel = controller.get_channel(f'hw_ai::{input_name}')
        channel.calibration = calibration.load()
    report_calibration(context, f'{manifest_id}_input_calibration',
                       calibration)


enamldef Microphone(ExperimentManifest): manifest:
    '''
    Defines a microphone. The IO manifest will be scanned for all channels that
    contain "microphone" in the name. The channels must follow the naming
    convention:

        * microphone_<name>

    Environment variables are used to configure the microphone, gain, and
    calibration. Here, <env_prefix> is set as an attribute on the manifest
    (defaults to CFTS_MICROPHONE) and <name> is the uppercased name of the
    microphone channel as identified in the IO manifest.

    <env_prefix>
        Indicates which microphone channel to use ('name' in
        `required_vars`).

    <env_prefix>_<name>_GAIN
        Indicates the current gain setting on the microphone amplifier
        ('gain' in `required_vars`).

    <env_prefix>_<name>
        A calibration string (provided by cftscal) that will load the
        correct calibration when passed to the `from_string` method of
        the manager for `microphone_type` ('calibration' in
        `required_vars`).

    Set `required_vars` to the subset of ['name', 'gain', 'calibration']
    the experiment actually needs. A paradigm that calibrates the
    microphone, for example, has no calibration to load yet. Missing
    entries are still applied when present in the environment, but no
    longer raise an error when absent.

    Once successfully initialized, a continous input named `<id>` will be
    available for use by other plugins.
    '''

    id = 'system_microphone'
    title = manifest.id.capitalize().replace('_', ' ')

    attr label_fmt = lambda x: re.sub(r'\bmicrophone\b', '', x, flags=re.IGNORECASE)
    attr env_prefix = 'CFTS_MICROPHONE'
    attr required_vars = ['name'] + list(INPUT_VARS)

    # This is the original microphone type we expected, so I have configured it
    # accordingly.
    attr microphone_type = 'measurement_microphone'
    attr connections_cb = getattr(util, f'list_{microphone_type}_connections')
    attr connections = connections_cb(as_expression=True, label_fmt=label_fmt)

    Extension:
        id = manifest.id + '.commands'
        point = 'enaml.workbench.core.commands'

        Command:
            id = manifest.id + '.initialize_microphone_settings'
            handler = functools.partial(initialize_microphone,
                                        manifest.id,
                                        manifest.microphone_type,
                                        manifest.env_prefix,
                                        manifest.required_vars)

    Extension:
        id = manifest.id + '.actions'
        point = 'psi.controller.actions'

        ExperimentAction:
            event = 'plugins_started'
            command = manifest.id + '.initialize_microphone_settings'

    Extension:
        id = manifest.id + '.io'
        point = 'psi.controller.io'

        ContinuousInput:
            name << manifest.id
            source_name = 'hw_ai::' + getattr(C, f'{manifest.id}_input')
            source::
                channel.gain = getattr(C, f'{manifest.id}_input_gain')

    Extension:
        id = manifest.id + '.context'
        point = 'psi.context.items'

        ContextRow:
            fmt = [f'{manifest.title}', microphone, 'with', gain, 'dB gain']
            name = f'{manifest.id}_settings'
            group_name = 'hardware_settings'

            EnumParameter: microphone:
                name = manifest.id + '_input'
                label = manifest.title
                choices = manifest.connections
                scope = 'experiment'

            Parameter: gain:
                name = manifest.id + '_input_gain'
                label = manifest.title + ' input gain (dB)'
                dtype = 'float64'
                default = 40
                scope = 'experiment'

        CalibrationParameter:
            name = f'{manifest.id}_input_calibration'
            label = f'{manifest.title} calibration'
            group_name = 'hardware_settings'


#: Environment variables read by `initialize_starship`. Unlike the other
#: objects, the names of these variables are not built from the variable
#: naming the starship (that one is side-specific, e.g.
#: CFTS_TEST_STARSHIP, while these are not), so the templates spell out
#: the full name instead of using `{prefix}`.
STARSHIP_VARS = {
    'gain': 'CFTS_STARSHIP_{name}_GAIN',
    'calibration': 'CFTS_STARSHIP_{name}',
}


def initialize_starship(manifest_id, side, required_vars, event):
    context = event.workbench.get_plugin('psi.context')
    controller = event.workbench.get_plugin('psi.controller')

    env = read_env_vars(manifest_id, f'CFTS_{side.upper()}_STARSHIP',
                        STARSHIP_VARS, required_vars)
    if (starship := env['name']) is None:
        # The calibration item is left reporting "not configured".
        return

    item_starship = context.get_item(f'{manifest_id}')
    item_starship.set_value(starship)
    item_starship.editable = False

    if (gain := env['gain']) is not None:
        item_gain = context.get_item(f'{manifest_id}_input_gain')
        item_gain.set_value(gain)
        item_gain.editable = False

    calibration = None
    if (cal_str := env['calibration']) is not None:
        calibration = starship_manager.from_string(cal_str)
        channel = controller.get_channel(f'hw_ai::{starship}_microphone')
        channel.calibration = calibration.load()
    report_calibration(context, f'{manifest_id}_calibration', calibration)


enamldef Starship(ExperimentManifest): manifest:
    '''
    Defines a starship that consists of one probe tube microphone and two
    speakers. The IO manifest will be scanned for all channels that contain
    "starship" in the name. The channels must follow the naming convention:

        * starship_<id>_primary
        * starship_<id>_secondary
        * starship_<id>_microphone

    If any of these channels are missing, that starship will not be available
    for selection.

    Environment variables are also needed to configure the starship. Here,
    <side> is set as an attribute on the manifest and <name> is the name as
    identified in the IO manifest:

    CFTS_<side>_STARSHIP
        Indicates which starship name to use ('name' in `required_vars`).

    CFTS_STARSHIP_<name>_GAIN
        Indicates the current gain setting on the mcirophone amplifier
        ('gain' in `required_vars`).

    CFTS_STARSHIP_<name>
        A calibration string (provided by cftscal) that will load the correct
        calibration when passed to `starship_manager.from_string`
        ('calibration' in `required_vars`).

    Attributes that change the behavior of the plugin.

    required_vars : list of string
        Subset of ['name', 'gain', 'calibration'] the experiment actually
        needs. A paradigm that calibrates the probe tube, for example,
        has no calibration to load yet. Missing entries are still applied
        when present in the environment, but no longer raise an error
        when absent.

    output_mode: {'dual', 'select'}
        If 'dual', then both oututp speakers are made available as outputs
        named <id>_primary and <id>_secondary. If 'select', then a parameter is
        added to the GUI that allows the user to select between "primary" and
        "secondary" outputs and a single output named <id>_output is made
        available.

    side : string
        When initializing a starship from environment variables, you can
        differentiate between starships designed for certain purposes (e.g.,
        test vs. nontest).

    swap_outputs : bool
        If True, swap the primary and secondary outputs when output_mode is set
        to 'dual'.  This means that the <id>_primary output is linked to
        starship_<id>_secondary channel and <id>_secondary output is linked to
        starship_<id>_primary channel. Has no effect when output_mode is set to
        'select'.
    '''

    id = 'starship'
    title = manifest.id.capitalize().replace('_', ' ')
    attr output_mode = 'dual'
    attr side = 'test'
    attr swap_outputs = False
    attr required_vars = ['name'] + list(STARSHIP_VARS)

    Extension:
        id = manifest.id + '.commands'
        point = 'enaml.workbench.core.commands'

        Command:
            id = manifest.id + '.initialize_starship_settings'
            handler = functools.partial(initialize_starship, manifest.id,
                                        manifest.side, manifest.required_vars)

    Extension:
        id = manifest.id + '.actions'
        point = 'psi.controller.actions'

        ExperimentAction:
            event = 'plugins_started'
            command = manifest.id + '.initialize_starship_settings'

    Extension:
        id = manifest.id + '.calibration_context'
        point = 'psi.context.items'

        CalibrationParameter:
            name = f'{manifest.id}_calibration'
            label = f'{manifest.title} calibration'
            group_name = 'hardware_settings'

    Extension:
        id = manifest.id + '.io'
        point = 'psi.controller.io'

        ContinuousInput:
            name = f'{manifest.id}_microphone'
            source_name = 'hw_ai::' + getattr(C, f'{manifest.id}') + '_microphone'
            source::
                channel.gain = getattr(C, f'{manifest.id}_input_gain')

        Conditional:
            condition = manifest.output_mode == 'dual'

            MUXOutput:
                name = f'{manifest.id}_primary'
                target_name = 'hw_ao::' + getattr(C, f'{manifest.id}') + \
                    ('_primary' if not manifest.swap_outputs else '_secondary')

            MUXOutput:
                name = f'{manifest.id}_secondary'
                target_name = 'hw_ao::' + getattr(C, f'{manifest.id}') + \
                    ('_secondary' if not manifest.swap_outputs else '_primary')

        Conditional:
            condition = manifest.output_mode == 'select'

            MUXOutput:
                name = f'{manifest.id}_output'
                target_name = 'hw_ao::' \
                    + getattr(C, f'{manifest.id}') + '_' \
                    + getattr(C, f'{manifest.id}_output')

    Conditional:
        condition << manifest.output_mode == 'select'

        Extension:
            id = manifest.id + '.context'
            point = 'psi.context.items'

            ContextRow:
                fmt = [f'{manifest.title}', starship, 'with', gain, 'dB gain'] \
                    if manifest.output_mode == 'dual' \
                    else [f'{manifest.title}', starship, 'with', gain, 'dB gain using', output, 'output']
                name = f'{manifest.id}_starship_settings'
                group_name = 'hardware_settings'

                EnumParameter: starship:
                    name = f'{manifest.id}'
                    label = f'{manifest.title}'
                    choices = {k: f'"{v}"' for k, v in list_starship_connections().items()}
                    scope = 'experiment'

                Parameter: gain:
                    name = f'{manifest.id}_input_gain'
                    label = f'{manifest.title} input gain (dB)'
                    dtype = 'float64'
                    default = 40
                    scope = 'experiment'

                EnumParameter: output:
                    name = f'{manifest.id}_output'
                    choices = {'primary': '"primary"', 'secondary': '"secondary"'}

    Conditional:
        condition << manifest.output_mode == 'dual'

        Extension:
            id = manifest.id + '.context'
            point = 'psi.context.items'

            ContextRow:
                fmt = [f'{manifest.title}', starship, 'with', gain, 'dB gain']
                name = f'{manifest.id}_starship_settings'
                group_name = 'hardware_settings'

                EnumParameter: starship:
                    name = f'{manifest.id}'
                    label = f'{manifest.title}'
                    choices = {k: f'"{v}"' for k, v in list_starship_connections().items()}
                    scope = 'experiment'

                Parameter: gain:
                    name = f'{manifest.id}_input_gain'
                    label = f'{manifest.title} input gain (dB)'
                    dtype = 'float64'
                    default = 40
                    scope = 'experiment'


#: Environment variables read by `initialize_input_amplifier`. An input
#: amplifier has no calibration; instead, it has the filter cutoffs dialed
#: in on the front panel of the amplifier.
INPUT_AMPLIFIER_VARS = {
    'gain': '{prefix}_{name}_GAIN',
    'freq_lb': '{prefix}_{name}_FREQ_LB',
    'freq_ub': '{prefix}_{name}_FREQ_UB',
}

#: Maps each setting read by `initialize_input_amplifier` to the suffix of
#: the context item it configures (e.g., 'eeg_highpass').
INPUT_AMPLIFIER_ITEMS = {
    'gain': 'gain',
    'freq_lb': 'highpass',
    'freq_ub': 'lowpass',
}


def initialize_input_amplifier(manifest_id, env_prefix, required_vars, event):
    context = event.workbench.get_plugin('psi.context')
    controller = event.workbench.get_plugin('psi.controller')

    env = read_env_vars(manifest_id, env_prefix, INPUT_AMPLIFIER_VARS,
                        required_vars)
    if (input_name := env['name']) is None:
        # User has to manually-configure the input amplifier now.
        return

    item_input_amplifier = context.get_item(f'{manifest_id}')
    # Quotes around the name are important!
    item_input_amplifier.expression = f'"{input_name}"'
    item_input_amplifier.editable = False

    for var, item_suffix in INPUT_AMPLIFIER_ITEMS.items():
        if (value := env[var]) is None:
            continue
        item = context.get_item(f'{manifest_id}_{item_suffix}')
        item.set_value(value)
        item.editable = False


enamldef InputAmplifier(ExperimentManifest): manifest:
    '''
    Defines an input amplifier (e.g., the amplifier the EEG electrodes are
    connected to).

    Environment variables are used to configure the amplifier. Here,
    <env_prefix> is set as an attribute on the manifest (defaults to
    CFTS_INPUT_AMPLIFIER) and <name> is the uppercased name of the input
    channel as identified in the IO manifest.

    <env_prefix>
        Indicates which input channel to use ('name' in `required_vars`).

    <env_prefix>_<name>_GAIN
        Indicates the current gain setting on the amplifier ('gain' in
        `required_vars`).

    <env_prefix>_<name>_FREQ_LB
        Indicates the current highpass filter cutoff, in Hz, dialed in on
        the amplifier ('freq_lb' in `required_vars`).

    <env_prefix>_<name>_FREQ_UB
        Indicates the current lowpass filter cutoff, in Hz, dialed in on
        the amplifier ('freq_ub' in `required_vars`).

    Set `required_vars` to the subset of ['name', 'gain', 'freq_lb',
    'freq_ub'] the experiment actually needs. Missing entries are still
    applied when present in the environment, but no longer raise an error
    when absent.
    '''

    id = 'input_amplifier'
    title = manifest.id.capitalize().replace('_', ' ')
    attr target_fs
    attr env_prefix = 'CFTS_INPUT_AMPLIFIER'
    attr required_vars = ['name'] + list(INPUT_AMPLIFIER_VARS)

    Extension:
        id = manifest.id + '.commands'
        point = 'enaml.workbench.core.commands'

        Command:
            id = manifest.id + '.initialize_input_amplifier_settings'
            handler = functools.partial(initialize_input_amplifier,
                                        manifest.id,
                                        manifest.env_prefix,
                                        manifest.required_vars)

    Extension:
        id = manifest.id + '.actions'
        point = 'psi.controller.actions'

        ExperimentAction:
            event = 'plugins_started'
            command = manifest.id + '.initialize_input_amplifier_settings'

    Extension:
        id = manifest.id + '.io'
        point = 'psi.controller.io'

        Conditional:
            condition << manifest.target_fs is not None

            ContinuousInput:
                name = f'{manifest.id}'
                source_name = 'hw_ai::' + getattr(C, f'{manifest.id}')
                #source::
                #    channel.gain = getattr(C, f'{manifest.id}_input_amplifier_gain')

                DecimateTo:
                    name = f'{manifest.id}_dec'
                    target_fs << manifest.target_fs

                    IIRFilter:
                        N = 2
                        btype = 'bandpass'
                        ftype = 'butter'
                        passthrough = not C.digital_filter
                        f_highpass = C.digital_highpass
                        f_lowpass = C.digital_lowpass
                        name = f'{manifest.id}_filtered'

        Conditional:
            condition << manifest.target_fs is None

            ContinuousInput:
                name = manifest.id
                source_name = 'hw_ai::' + getattr(C, f'{manifest.id}')

                IIRFilter:
                    N = 2
                    btype = 'bandpass'
                    ftype = 'butter'
                    passthrough = not C.digital_filter
                    f_highpass = C.digital_highpass
                    f_lowpass = C.digital_lowpass
                    name = f'{manifest.id}_filtered'

    Extension:
        id = manifest.id + '.input_amplifier.context'
        point = 'psi.context.items'

        ContextRow:
            fmt = [f'{manifest.title}', input_amplifier, 'with', gain, '✕ gain']
            name = f'{manifest.id}_input_amplifier_settings'
            group_name = 'hardware_settings'

            EnumParameter: input_amplifier:
                name = f'{manifest.id}'
                label = f'{manifest.title}'
                choices = {k: f'"{v}"' for k, v in list_input_amplifier_connections().items()}
                scope = 'experiment'

            Parameter: gain:
                name = f'{manifest.id}_gain'
                dtype = 'float64'
                default = 50e3
                scope = 'experiment'

        ContextRow:
            fmt = [f'{manifest.title} filter set to', hp, 'to', lp, 'Hz']
            group_name = 'hardware_settings'

            Parameter: hp:
                name = f'{manifest.id}_highpass'
                label = 'Amplifier highpass filter cutoff'
                default = 10
                scope = 'experiment'

            Parameter: lp:
                name = f'{manifest.id}_lowpass'
                label = 'Amplifier lowpass filter cutoff'
                default = 10e3
                scope = 'experiment'
                group_name = 'hardware_settings'

        ContextRow:
            name = 'digital_filter_settings'
            fmt << ['Digital filter?', filt_on] \
                if filt_on.expression == 'False' else \
                ['Digital filter?', filt_on, 'from', filt_hp, 'to', filt_lp, 'Hz']
            group_name = 'acquisition'

            BoolParameter: filt_on:
                name = 'digital_filter'
                label = 'Digital filter?'
                scope = 'experiment'
                default = True

            Parameter: filt_hp:
                name = 'digital_highpass'
                label = 'Digital highpass filter cutoff'
                default = 300
                scope = 'experiment'

            Parameter: filt_lp:
                name = 'digital_lowpass'
                label = 'Digital lowpass filter cutoff'
                default = 3000
                scope = 'experiment'
