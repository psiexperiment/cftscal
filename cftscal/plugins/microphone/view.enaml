import numpy as np

from enaml.core.api import Conditional, Looper
from enaml.layout.api import align, hbox, spacer, vbox, AreaLayout, HSplitLayout, VSplitLayout
from enaml.stdlib.fields import FloatField
from enaml.widgets.api import (
    Container, DockArea, DockItem, Field, HGroup, Label, ObjectCombo,
    PushButton
)

from psi.data.plots_manifest import PGCanvas

from cftscal.objects import measurement_microphone_manager
from cftscal.plugins.widgets import (
    AddItem, CalibratedObjects, GroupPathPicker, SensorView, ObjectCollection,
    SinglePlotManager,
)


class MicrophonePlotManager(SinglePlotManager):

    y_label = 'Measured Voltage'

    def _update(self, calibration, remove=False):
        plot_id = self.get_plot_id(calibration)
        if remove:
            self.remove_plots(plot_id)
            return None
        color, plots = self.get_plots(plot_id)

        fh = calibration.load_recording()
        psd = fh.get_psd(average_seconds=1).iloc[1:]
        x = np.log10(psd.index.values)
        y = psd.values
        plots[0].setData(x, y)
        return {'color': color}


enamldef MicrophoneView(Container):

    attr settings

    DockArea: area:
        layout = AreaLayout(
            HSplitLayout(
                VSplitLayout(
                    'settings',
                    'mic_list',
                    sizes=[25, 200],
                ),
                'mic_sens_plot',
                sizes=[150, 900],
            ),
        )
        DockItem:
            name = 'settings'
            title = 'Settings'
            closable = False
            stretch = 0

            Conditional:
                condition << settings is None

                Container:
                    Label:
                        text = 'No microphones found on system. View mode only.'

            Conditional:
                condition << settings is not None

                Container:
                    layout_constraints => ():
                        widgets = self.visible_widgets()
                        second = [w.visible_widgets()[1] for w in widgets if isinstance(w, HGroup)]
                        constraints = [
                            vbox(
                                *widgets[:-1],
                                hbox(spacer(0), widgets[-1]),
                                spacing=0,
                            ),
                            align('left', *second),
                        ]
                        return constraints

                    GroupPathPicker:
                        plugin_settings = settings
                        subfolder = 'microphone'

                    HGroup:
                        padding = 0
                        share_layout = True
                        align_widths = False
                        constraints = [
                            pistonphone_frequency.width == 50,
                            pistonphone_level.width == 50,
                        ]

                        Label: pistonphone_label:
                            text = 'Pistonphone'

                        Field: pistonphone_select:
                            text := settings.pistonphone.name

                        FloatField: pistonphone_frequency:
                            value := settings.pistonphone.frequency

                        Label: pistonphone_frequency_label:
                            text = 'Hz @'

                        FloatField: pistonphone_level:
                            value := settings.pistonphone.level

                        Label: pistonphone_level_label:
                            text = 'dB SPL'

                    HGroup:
                        share_layout = True
                        align_widths = False
                        padding = 0
                        spacing = 5

                        Label:
                            text = 'Input Channel'

                        ObjectCombo:
                            items = settings.available_inputs
                            selected := settings.selected_input
                            to_string = lambda m: m.input_label

                    SensorView:
                        mode = 'add'
                        sensor << settings.selected_input.sensor

                    PushButton: start:
                        text = 'Calibrate'
                        enabled << bool(settings.selected_input.sensor.name)
                        clicked ::
                            settings.run_calibration(settings.selected_input)
                            mic_tree.collection.update_groups()

        DockItem:
            name = 'mic_sens_plot'
            title = 'Microphone Voltage'
            closable = False
            stretch = 10

            Container:
                PGCanvas: microphone_plot:
                    attr manager = MicrophonePlotManager()
                    component << manager.component

        DockItem:
            name = 'mic_list'
            title = 'Microphone Calibrations'
            closable = False
            stretch = 0

            CalibratedObjects: mic_tree:
                mapping = {
                    'Name': {
                        'groupby': True,
                        'id': True,
                        'to_str': lambda x: x.name,
                    },
                    'Date': {
                        'groupby': False,
                        'id': True,
                        'to_str': lambda x: str(x.datetime),
                    },
                    'Sens': {
                        'to_str': lambda x: f'{x.sens:.2f} mV/Pa',
                    },
                    'Sens (dB)': {
                        'to_str': lambda x: f'{x.sens_db:.2f} dB(mV/Pa)',
                    },
                    'Pistonphone': {
                        'to_str': lambda x: x.pistonphone,
                    },
                }

                collection = ObjectCollection(
                    measurement_microphone_manager, [microphone_plot.manager],
                )
