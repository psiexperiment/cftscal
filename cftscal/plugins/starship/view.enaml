import numpy as np

from enaml.core.api import Conditional
from enaml.layout.api import align, hbox, spacer, vbox, AreaLayout, HSplitLayout, VSplitLayout
from enaml.stdlib.fields import FloatField
from enaml.stdlib.message_box import warning
from enaml.widgets.api import (
    Container, DockArea, DockItem, Field, HGroup, Label, ObjectCombo,
    PushButton
)

from psi.data.plots_manifest import PGCanvas

from cftscal.objects import starship_manager
from cftscal.plugins.widgets import (
    AddItem, CalibratedObjects, GroupPathPicker, SensorView, SinglePlotManager,
    ObjectCollection, _remove_selected,
)


class StarshipPlotManager(SinglePlotManager):

    def _update(self, calibration, remove=False):
        plot_id = self.get_plot_id(calibration)
        if remove:
            self.remove_plots(plot_id)
            return None

        color, plots = self.get_plots(plot_id)

        cal = calibration.load()
        x = np.log10(cal.frequency[1:])
        y = cal.sensitivity[1:]
        plots[0].setData(x, y)
        return {'color': color}


enamldef StarshipView(Container): starship_view:

    attr settings

    DockArea: area:
        layout = AreaLayout(
            HSplitLayout(
                VSplitLayout(
                    'settings',
                    'starship_list',
                    sizes=[25, 900],
                ),
                'starship_sens_plot',
                sizes=[150, 900],
            ),
        )

        DockItem:
            name = f'settings'
            title = f'Settings'
            closable = False
            stretch = 0

            Conditional:
                condition << settings is None

                Container:
                    Label:
                        text = 'No starships found on system. View mode only.'

            Conditional:
                condition << settings is not None

                Container:
                    attr microphone << settings.selected_input
                    layout_constraints => ():
                        widgets = self.visible_widgets()
                        first = []
                        second = []
                        for w in widgets:
                            # w.children would include Conditional/Looper
                            # markers themselves (not just their generated
                            # content) -- visible_widgets() resolves those
                            # to the actual constrainable widgets, same as
                            # self.visible_widgets() above already does at
                            # this level. Using raw .children here worked
                            # only by coincidence of activation timing/
                            # ordering, and broke once SensorView (one of
                            # the rows below) gained a second leading
                            # Conditional.
                            row = w.visible_widgets()
                            first.append(row[0])
                            for c in row[1:]:
                                if isinstance(c, Label):
                                    second.append(c)
                                    break

                        constraints = [
                            vbox(*widgets, spacing=5),
                            align('right', *first),
                            align('left', *second),
                            align('right', *second),
                        ]
                        return constraints

                    Container:
                        share_layout = True
                        padding = 0

                        constraints = [
                            hbox(
                                mic_label,
                                mic_channel,
                                mic_sensor,
                                spacing=5,
                            )
                        ]

                        Label: mic_label:
                            text = 'Cal. Mic.'

                        ObjectCombo: mic_channel:
                            items = sorted(settings.available_inputs, key=lambda x: x.input_label)
                            selected := settings.selected_input
                            to_string = lambda m: m.input_label

                        SensorView: mic_sensor:
                            sensor << settings.selected_input.sensor
                            collection << starship_tree.collection
                            show_label = False

                    HGroup:
                        share_layout = True
                        padding = 0
                        spacing = 5
                        align_widths = False

                        Label: coupler_label:
                            text = 'Coupler'

                        ObjectCombo: coupler:
                            items := settings.available_couplers
                            selected := settings.calibration_coupler

                        PushButton: coupler_add:
                            text = '+'
                            constraints = [width == 25]
                            clicked ::
                                popup = AddItem(self, combo=coupler, label='Coupler')
                                popup.show()

                        PushButton: coupler_remove:
                            text = '-'
                            constraints = [width == 25]
                            enabled << bool(coupler.selected)
                            clicked ::
                                _remove_selected(coupler)

                    Container:
                        attr starship << settings.selected_starship
                        attr mic_settings << settings.selected_input
                        padding = 0
                        share_layout=True

                        # Refresh the selected starship's dropdown after
                        # a new calibration is recorded — pick up
                        # newly-added starships without reloading the
                        # plugin. `starship` is re-read at call time, so
                        # this still refreshes the right one even if the
                        # selected connection changed since this observer
                        # was registered.
                        func _on_collection_updated(change):
                            starship.refresh_available()

                        initialized ::
                            starship_tree.collection.observe(
                                'updated', _on_collection_updated,
                            )
                        constraints = [
                            vbox(
                                hbox(
                                    starship_label,
                                    hbox(
                                        starship_channel,
                                        starship_select,
                                        starship_add,
                                        starship_remove,
                                        spacing=5,
                                    ),
                                    starship_gain,
                                    starship_gain_label,
                                    spacing=5,
                                ),
                                starship_target,
                                hbox(spacer(0), golay_start, chirp_start, spacing=5),
                                spacing=5,
                            ),
                            starship_add.width == 25,
                            starship_remove.width == 25,
                            align('v_center', starship_label, starship_channel,
                                  starship_select, starship_add, starship_remove,
                                  starship_gain, starship_gain_label),
                            align('width', starship_label,
                                  starship_target.visible_widgets()[0]),
                        ]

                        Label: starship_label:
                            text = 'Starship'

                        ObjectCombo: starship_channel:
                            items = settings.starship_connections
                            selected := settings.selected_starship
                            to_string = lambda s: s.connection_label

                        ObjectCombo: starship_select:
                            items << starship.available_starships
                            selected := starship.starship

                        PushButton: starship_add:
                            text = '+'
                            clicked ::
                                popup = AddItem(self, combo=starship_select, label='Starship')
                                popup.show()

                        PushButton: starship_remove:
                            text = '-'
                            enabled << bool(starship_select.selected)
                            clicked ::
                                _remove_selected(starship_select)

                        ObjectCombo: starship_gain:
                            items = [20, 40]
                            selected := starship.gain

                        Label: starship_gain_label:
                            text = 'dB gain'

                        GroupPathPicker: starship_target:
                            plugin_settings = settings
                            subfolder = 'starship'
                            collection << starship_tree.collection
                            path_target << starship

                        PushButton: golay_start:
                            text = 'Golay'
                            enabled << bool(mic_settings.sensor.name) \
                                and bool(starship.starship) \
                                and '(' not in starship.starship
                            clicked ::
                                try:
                                    settings.run_cal_golay(starship, mic_settings)
                                except (ValueError, LookupError) as exc:
                                    warning(self, 'Cannot calibrate', str(exc))
                                else:
                                    starship_tree.collection.update_groups()

                        PushButton: chirp_start:
                            text = 'Chirp'
                            enabled << bool(mic_settings.sensor.name) \
                                and bool(starship.starship) \
                                and '(' not in starship.starship
                            clicked ::
                                try:
                                    settings.run_cal_chirp(starship, mic_settings)
                                except (ValueError, LookupError) as exc:
                                    warning(self, 'Cannot calibrate', str(exc))
                                else:
                                    starship_tree.collection.update_groups()

        DockItem:
            name = 'starship_sens_plot'
            title = 'Starship Sensitivity'
            closable = False
            stretch = 10

            Container:
                PGCanvas: starship_plot:
                    attr manager = StarshipPlotManager()
                    component << manager.component

        DockItem:
            name = 'starship_list'
            title = 'Calibrations'
            closable = False
            stretch = 0

            CalibratedObjects: starship_tree:
                enable_current = True
                mapping = {
                    'Name': {
                        'groupby': True,
                        'id': True,
                        'to_str': lambda x: x.name,
                    },
                    'Device': {
                        # Explicit device ID from metadata, independent of
                        # which folder this calibration happens to be
                        # filed under -- the tree is organized for
                        # convenience and may not match this. Compare
                        # against 'Name' to spot a mismatch.
                        'groupby': False,
                        'id': False,
                        'to_str': lambda x: getattr(x, 'starship', ''),
                    },
                    'Microphone': {
                        'groupby': False,
                        'id': False,
                        'to_str': lambda x: getattr(x, 'microphone', '?'),
                    },
                    'Mic. Channel': {
                        'groupby': False,
                        'id': False,
                        'to_str': lambda x: getattr(x, 'microphone_channel', ''),
                    },
                    'Starship Channel': {
                        'groupby': False,
                        'id': False,
                        'to_str': lambda x: getattr(x, 'starship_channel', ''),
                    },
                    'Gain': {
                        'groupby': False,
                        'id': False,
                        'to_str': lambda x: f'{x.gain:g} dB' if getattr(x, 'gain', None) is not None else '?',
                    },
                    'Mic. Gain': {
                        'groupby': False,
                        'id': False,
                        'to_str': lambda x: f'{x.microphone_gain:g} dB' if getattr(x, 'microphone_gain', None) is not None else '?',
                    },
                    'Coupler': {
                        'groupby': False,
                        'id': False,
                        'to_str': lambda x: getattr(x, 'coupler', '?'),
                    },
                    'Stimulus': {
                        'groupby': False,
                        'id': False,
                        'to_str': lambda x: getattr(x, 'stimulus', '?'),
                    },
                }
                collection = ObjectCollection(
                    starship_manager, [starship_plot.manager]
                )
