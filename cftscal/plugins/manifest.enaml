import importlib
import importlib.resources
import logging
log = logging.getLogger(__name__)

from atom.api import Dict, Int, Property, Str, Value
from enaml.core.api import d_

from enaml.workbench.api import Extension, PluginManifest
from enaml.workbench.core.api import Command
from enaml.workbench.ui.api import (Branding, ActionItem, MenuItem, ItemGroup,
                                    Workspace)
from .calibration_window import CalibrationWindow

from .workspace import WorkspaceSettings
from .workspace_view import WorkspaceSettingsView
from enaml.widgets.api import Window


def load_app_icon():
    """Load cftscal/icons/main-icon.png as an Enaml `Icon` for window branding.

    Uses `importlib.resources` rather than a `__file__`-relative path so
    this keeps working if cftscal is ever installed as a zipped wheel.
    """
    from enaml.icon import Icon, IconImage
    from enaml.image import Image

    data = importlib.resources.files('cftscal').joinpath(
        'icons', 'main-icon.png').read_bytes()
    return Icon(images=[IconImage(image=Image(data=data, format='png'))])


# Single source of truth for all calibration plugins.  Used both at startup
# (main.py) and when reloading after a settings change.
TO_REGISTER = [
    ('cftscal.plugins.microphone.manifest',        'MeasurementMicrophoneManifest'),
    ('cftscal.plugins.microphone_generic.manifest', 'GenericMicrophoneManifest'),
    ('cftscal.plugins.speaker.manifest',            'SpeakerManifest'),
    ('cftscal.plugins.input_recording.manifest',    'InputRecordingManifest'),
    ('cftscal.plugins.ir_sensor.manifest',          'IRSensorManifest'),
    ('cftscal.plugins.input_amplifier.manifest',    'InputAmplifierManifest'),
    ('cftscal.plugins.starship.manifest',           'StarshipManifest'),
    ('cftscal.plugins.inear.manifest',              'InEarManifest'),
]


def reload_plugins(workbench):
    """Re-inspect all calibration plugins after workspace settings change.

    Clears the cached IO manifest so hardware detection runs against the new
    configuration, then registers/unregisters plugins as their availability
    changes.  If the currently active workspace is affected it is reloaded so
    its settings pick up the new IO channels.
    """
    import enaml
    from cftscal.util import reset_io_manifest

    reset_io_manifest()

    ui   = workbench.get_plugin('enaml.workbench.ui')
    core = workbench.get_plugin('enaml.workbench.core')

    # Identify the active workspace's plugin by matching window_title.
    active_plugin_id = None
    if ui.workspace is not None:
        active_title = ui.workspace.window_title

    with enaml.imports():
        for rank, (module_name, class_name) in enumerate(TO_REGISTER):
            try:
                module  = importlib.import_module(module_name)
                cls     = getattr(module, class_name)
                probe   = cls(rank=rank)
                plugin_id    = probe.id
                is_available = probe.available
                is_registered = workbench.get_manifest(plugin_id) is not None

                if (ui.workspace is not None
                        and hasattr(probe, 'title')
                        and probe.title == active_title):
                    active_plugin_id = plugin_id

                if is_registered and not is_available:
                    # Close the workspace before unregistering its plugin.
                    if active_plugin_id == plugin_id:
                        ui.close_workspace()
                        active_plugin_id = None
                    workbench.unregister(plugin_id)
                    log.info('Unregistered plugin: %s', plugin_id)
                elif not is_registered and is_available:
                    workbench.register(cls(rank=rank))
                    log.info('Registered plugin: %s', plugin_id)
                # Registered + still available: leave in place; workspace
                # reload below will recreate its content with fresh settings.

            except Exception:
                log.exception('Error reloading %s.%s', module_name, class_name)

    # Reload the active workspace so workspace_factory runs again with the
    # updated IO manifest and any new channel assignments.
    if active_plugin_id is not None:
        core.invoke_command(
            'enaml.workbench.ui.select_workspace',
            {'workspace': f'{active_plugin_id}.workspace'},
        )


def list_plugin_info():
    '''
    Instantiate every TO_REGISTER entry just far enough to read its
    id/title, for populating the Workspace Settings plugin checklist.
    Mirrors the probing reload_plugins() already does above.
    '''
    import enaml
    info = []
    with enaml.imports():
        for module_name, class_name in TO_REGISTER:
            try:
                module = importlib.import_module(module_name)
                probe = getattr(module, class_name)()
                info.append({'id': probe.id, 'title': probe.title})
            except Exception:
                log.exception('Error probing %s.%s for plugin info',
                              module_name, class_name)
    return info


def set_defaults(event):
    ui = event.workbench.get_plugin('enaml.workbench.ui')
    if ui.workspace is None or ui.workspace.content is None:
        return
    ui.workspace.content.settings.save_config()


def show_workspace_settings(event):
    workbench = event.workbench
    settings = WorkspaceSettings()
    settings._on_save = lambda: reload_plugins(workbench)
    view = WorkspaceSettingsView(settings=settings, plugin_info=list_plugin_info())
    view.show()


enamldef CalibrationManifest(PluginManifest): manifest:
    id = 'calibration'

    Extension:
        id = 'calibration_commands'
        point = 'enaml.workbench.core.commands'

        Command:
            id = 'psical.set_defaults'
            handler = set_defaults

        Command:
            id = 'psical.workspace_settings'
            handler = show_workspace_settings

    Extension:
        id = 'calibration_branding'
        point = 'enaml.workbench.ui.branding'
        Branding:
            title = 'CFTS Calibration'
            icon = load_app_icon()

    Extension:
        id = 'calibration_window'
        point = 'enaml.workbench.ui.window_factory'
        factory = lambda workbench: CalibrationWindow()

    Extension:
        id = 'calibration_actions'
        point = 'enaml.workbench.ui.actions'
        MenuItem:
            path = '/workspace'
            label = 'Workspace'
            ItemGroup:
                id = 'spaces'

        ActionItem:
            path = '/workspace/settings'
            label = 'Settings'
            command = 'psical.workspace_settings'

        ActionItem:
            path = '/workspace/set_defaults'
            label = 'Set Defaults'
            shortcut = 'Ctrl+d'
            command = 'psical.set_defaults'
            enabled << manifest.workbench.get_plugin('enaml.workbench.ui').workspace is not None


def workspace_factory(window, manifest):
    space = Workspace()
    space.window_title = manifest.title
    try:
        kwargs = {k: v() for k, v in manifest.settings_config.items()}
        settings = manifest.settings_class(**kwargs)
        settings.load_config()
        space.content = manifest.view_class(settings=settings)
    except ValueError:
        space.content = manifest.view_class()
    return space


class _CalibrationPluginManifest(PluginManifest):

    title = d_(Str())
    shortcut = d_(Str())
    view_class = d_(Value())
    settings_class = d_(Value())
    settings_config = d_(Dict())
    #: This plugin's position in TO_REGISTER -- passed explicitly as a
    #: constructor kwarg by main.py/reload_plugins() (a plugin doesn't
    #: otherwise know its own position in that shared list). Drives the
    #: Extension.rank below, which is what actually orders same-group
    #: ActionItems in the Workspace menu (enaml.workbench.ui sorts an
    #: extension point's contributions by rank, low to high; without
    #: this they all default to rank 0 and ties are broken by whatever
    #: order the plugins happened to be registered in -- which drifts
    #: from TO_REGISTER's order whenever reload_plugins() re-registers
    #: a plugin at a different time than the others, e.g. after a
    #: workspace settings change).
    rank = d_(Int())
    available = Property()

    def _get_available(self):
        # A plugin's id in WorkspaceSettings.enabled_plugins forces it to
        # load in view-only mode regardless of what the hardware probes
        # below report -- e.g. for reviewing calibrations on a machine
        # without the relevant hardware. Set via Workspace > Settings.
        if self.id in WorkspaceSettings().enabled_plugins:
            return True
        for cb in self.settings_config.values():
            if not bool(cb(raise_error=False)):
                return False
        return True


enamldef CalibrationPluginManifest(_CalibrationPluginManifest): manifest:

    Extension:
        id = manifest.id + '.actions'
        point = 'enaml.workbench.ui.actions'
        rank = manifest.rank
        ActionItem:
            path = '/workspace/' + manifest.id
            label = manifest.title
            shortcut = manifest.shortcut
            group = 'spaces'
            command = 'enaml.workbench.ui.select_workspace'
            parameters = {'workspace': manifest.id + '.workspace'}

    Extension:
        id = 'workspace'
        point = 'enaml.workbench.ui.workspaces'
        factory = lambda w: workspace_factory(w, manifest)
