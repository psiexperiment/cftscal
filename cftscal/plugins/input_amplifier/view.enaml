import numpy as np

import pyqtgraph as pg

from enaml.core.api import Conditional
from enaml.layout.api import align, hbox, spacer, vbox, AreaLayout, HSplitLayout, VSplitLayout
from enaml.stdlib.fields import FloatField
from enaml.widgets.api import (
    Container, DockArea, DockItem, Field, Label, ObjectCombo, PushButton
)

from psi.data.plots_manifest import PGCanvas

from cftscal.objects import input_amplifier_manager
from cftscal.plugins.widgets import (
    AddItem, CalibratedObjects, GroupPathPicker, SinglePlotManager,
    ObjectCollection, InputAmplifierView
)


class InputAmplifierPlotManager(SinglePlotManager):

    y_label = 'Measured Voltage'
    x_label = 'Time'
    x_units = 'sec'
    x_log_mode = False
    y_units = 'V'

    def _update(self, calibration, remove=False):
        plot_id = self.get_plot_id(calibration)
        if remove:
            self.remove_plots(plot_id)
            return None

        color, plots = self.get_plots(plot_id)
        fh = calibration.load_recording()
        waveform = fh.cal_signal
        plots[0].setData(waveform.index.values, waveform['amplitude'].values)
        return {'color': color}


enamldef InputAmplifierView(Container): container:

    attr settings

    DockArea: area:
        layout = AreaLayout(
            HSplitLayout(
                VSplitLayout(
                    'settings',
                    'amp_list',
                    sizes=[25, 200],
                ),
                'amp_gain_plot',
                sizes=[150, 900],
            ),
        )
        DockItem:
            name = 'settings'
            title = 'Settings'
            closable = False
            stretch = 0

            Conditional:
                condition << settings is None

                Container:
                    Label:
                        text = 'No input amplifiers found on system. View mode only.'

            Conditional:
                condition << settings is not None

                Container:
                    constraints = [
                        vbox(
                            hbox(input_label, input_select),
                            amp_settings,
                            amp_path,
                            hbox(spacer(0), amp_cal_start),
                            spacing=0,
                        )
                    ]

                    Label: input_label:
                        text = 'Input'

                    ObjectCombo: input_select:
                        items = settings.available_inputs
                        selected := settings.selected_input
                        to_string = lambda ai: ai.input_label

                    InputAmplifierView: amp_settings:
                        sensor << settings.selected_input.sensor
                        mode = 'add'

                    GroupPathPicker: amp_path:
                        plugin_settings = settings
                        subfolder = 'input_amplifier'
                        collection << amp_tree.collection
                        path_target << settings.selected_input

                    PushButton: amp_cal_start:
                        text = 'Calibrate'
                        enabled << bool(settings.selected_input.sensor.name)
                        clicked ::
                            settings.run_calibration(settings.selected_input)
                            amp_tree.collection.update_groups()

        DockItem:
            name = 'amp_gain_plot'
            title = 'Input Amplifier Sensitivity'
            closable = False
            stretch = 10

            Container:
                PGCanvas: input_amplifier_plot:
                    attr manager = InputAmplifierPlotManager()
                    component << manager.component

        DockItem:
            name = 'amp_list'
            title = 'Calibrations'
            closable = False
            stretch = 0

            CalibratedObjects: amp_tree:
                mapping = {
                    'Name': {
                        'groupby': True,
                        'id': True,
                        'to_str': lambda x: x.name,
                    },
                    'Date': {
                        'groupby': False,
                        'id': True,
                        'to_str': lambda x: str(x.datetime),
                    },
                    'Meas. Gain': {
                        'to_str': lambda x: f'{x.measured_gain:.2f} x',
                    }
                }
                collection = ObjectCollection(
                    input_amplifier_manager, [input_amplifier_plot.manager],
                )
