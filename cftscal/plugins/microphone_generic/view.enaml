import numpy as np

from enaml.core.api import Conditional
from enaml.layout.api import align, hbox, spacer, vbox, AreaLayout, HSplitLayout, VSplitLayout
from enaml.stdlib.message_box import warning
from enaml.widgets.api import (
    Container, DockArea, DockItem, HGroup, Label, ObjectCombo, PushButton
)

from psi.data.plots_manifest import PGCanvas

from cftscal.objects import generic_microphone_manager
from cftscal.plugins.widgets import (
    AddItem, CalibratedObjects, GroupPathPicker, SinglePlotManager,
    ObjectCollection, SensorView, _remove_selected,
)


class MicrophoneComparisonPlotManager(SinglePlotManager):

    def _update(self, calibration, remove=False):
        plot_id = self.get_plot_id(calibration)
        if remove:
            self.remove_plots(plot_id)
            return None

        color, plots = self.get_plots(plot_id)

        cal = calibration.load()
        x = np.log10(cal.frequency[1:])
        y = cal.sensitivity[1:]
        plots[0].setData(x, y)
        return {'color': color}


enamldef MicrophoneComparisonView(Container): view:

    attr settings

    DockArea: area:
        layout = AreaLayout(
            HSplitLayout(
                VSplitLayout(
                    'settings',
                    'device_list',
                    sizes=[25, 900],
                ),
                'device_sens_plot',
                sizes=[150, 900],
            ),
        )

        DockItem:
            name = f'settings'
            title = f'Settings'
            closable = False
            stretch = 0

            Conditional:
                condition << settings is None

                Container:
                    Label:
                        text = 'No microphones found on system. View mode only.'

            Conditional:
                condition << settings is not None

                Container:
                    share_layout = True

                    layout_constraints => ():
                        constraints = [
                            vbox(
                                header, test_row, ref_row, speaker_row,
                                target_row,
                                hbox(spacer(0), golay_start, chirp_start,
                                     spacing=5),
                                spacing=5,
                            ),
                        ]
                        labels = [
                            header.visible_widgets()[0],
                            test_row.visible_widgets()[0],
                            ref_row.visible_widgets()[0],
                            speaker_row.visible_widgets()[0],
                            target_row.visible_widgets()[0],
                        ]
                        constraints.append(align('left', *labels))
                        constraints.append(align('width', *labels))
                        combos = [
                            header.visible_widgets()[1],
                            test_row.visible_widgets()[1],
                            ref_row.visible_widgets()[1],
                            speaker_row.visible_widgets()[1],
                        ]
                        constraints.append(align('left', *combos))
                        constraints.append(align('width', *combos))

                        test_sensor = test_row.visible_widgets()[-1]
                        ref_sensor = ref_row.visible_widgets()[-1]
                        gains = [
                            test_sensor.visible_widgets()[-2],
                            ref_sensor.visible_widgets()[-2],
                        ]
                        constraints.append(align('left', *gains))
                        constraints.append(align('width', *gains))
                        gain_labels = [
                            test_sensor.visible_widgets()[-1],
                            ref_sensor.visible_widgets()[-1],
                        ]
                        constraints.append(align('left', *gain_labels))
                        constraints.append(align('width', *gain_labels))
                        return constraints

                    HGroup: header:
                        # Blank/heading labels align above the respective
                        # elements in the rows below via the width
                        # constraints in layout_constraints.
                        share_layout = True
                        align_widths = False
                        padding = 0
                        spacing = 5

                        Label:
                            text = ''

                        Label:
                            text = 'Channel'

                        Label:
                            text = 'Device'

                    HGroup: test_row:
                        share_layout = True
                        align_widths = False
                        padding = 0
                        spacing = 5

                        Label:
                            text = 'Test'

                        ObjectCombo:
                            items = settings.generic_inputs
                            selected := settings.generic_input
                            to_string = lambda m: m.input_label

                        # The generic input's sensor is a SensorDevice
                        # (the physical mic being calibrated).  Render it
                        # with SensorView in device mode so it gets the
                        # +/- device-ID management and gain picker -- the
                        # same widget the reference row uses below, just
                        # bound to available_devices.
                        SensorView:
                            mode = 'device'
                            label = 'Device'
                            show_label = False
                            sensor << settings.generic_input.sensor

                    HGroup: ref_row:
                        share_layout = True
                        align_widths = False
                        padding = 0
                        spacing = 5

                        Label:
                            text = 'Ref.'

                        ObjectCombo:
                            items = settings.measurement_inputs
                            selected := settings.measurement_input
                            to_string = lambda m: m.input_label

                        SensorView:
                            mode = 'static'
                            label = 'Reference Microphone'
                            show_label = False
                            sensor << settings.measurement_input.sensor
                            collection << device_tree.collection

                    HGroup: speaker_row:
                        share_layout = True
                        align_widths = False
                        padding = 0
                        spacing = 5
                        trailing_spacer = spacer(0)

                        Label:
                            text = 'Speaker'

                        ObjectCombo:
                            items = settings.speaker_outputs
                            selected := settings.speaker_output
                            to_string = lambda s: s.output_label

                    # Target folder on its own row, bound to the
                    # currently-selected generic (test) input so switching
                    # test channels swaps in that channel's saved target
                    # folder.
                    GroupPathPicker: target_row:
                        plugin_settings = settings
                        subfolder = 'microphone_generic'
                        collection << device_tree.collection
                        path_target << settings.generic_input
                        show_label = True

                    PushButton: golay_start:
                        text = 'Golay'
                        clicked ::
                            try:
                                settings.run_calibration('golay')
                            except (ValueError, LookupError) as exc:
                                warning(self, 'Cannot calibrate', str(exc))
                            else:
                                device_tree.collection.update_groups()

                    PushButton: chirp_start:
                        text = 'Chirp'
                        clicked ::
                            try:
                                settings.run_calibration('chirp')
                            except (ValueError, LookupError) as exc:
                                warning(self, 'Cannot calibrate', str(exc))
                            else:
                                device_tree.collection.update_groups()

        DockItem:
            name = 'device_sens_plot'
            title = 'Generic Microphone Sensitivity'
            closable = False
            stretch = 10

            Container:
                PGCanvas: device_plot:
                    attr manager = MicrophoneComparisonPlotManager()
                    component << manager.component

        DockItem:
            name = 'device_list'
            title = 'Calibrations'
            closable = False
            stretch = 0

            CalibratedObjects: device_tree:
                enable_current = True
                mapping = {
                    'Name': {
                        'groupby': True,
                        'id': True,
                        'to_str': lambda x: x.name,
                    },
                    'Date': {
                        'groupby': False,
                        'id': True,
                        'to_str': lambda x: str(x.datetime),
                    },
                    'Device': {
                        # Explicit device ID from metadata, independent of
                        # which folder this calibration happens to be
                        # filed under -- the tree is organized for
                        # convenience and may not match this. Compare
                        # against 'Name' to spot a mismatch.
                        'to_str': lambda x: x.sensor_id,
                    },
                    'Input': {
                        'to_str': lambda x: x.input_channel,
                    },
                    'Gain': {
                        'to_str': lambda x: f'{x.gain:g} dB' if x.gain is not None else '?',
                    },
                    'Microphone': {
                        'to_str': lambda x: x.microphone,
                    },
                    'Mic. Channel': {
                        'to_str': lambda x: x.microphone_channel,
                    },
                    'Speaker': {
                        'to_str': lambda x: x.speaker,
                    },
                    'Speaker Channel': {
                        'to_str': lambda x: x.speaker_channel,
                    },
                    'Max. Freq.': {
                        'to_str': lambda x: f'{x.max_frequency*1e-3:.0f} kHz',
                    },
                }

                collection = ObjectCollection(
                    generic_microphone_manager, [device_plot.manager],
                )
