import os
from pathlib import Path

from enaml.core.api import Conditional
from enaml.layout.api import align, hbox, spacer, vbox
from enaml.widgets.api import (
    Container, Label, Field, HGroup, ObjectCombo, PushButton, FileDialogEx, Form,
    Window, DockArea, DockItem, ScrollArea
)

from psi.core.enaml.api import ListDictTable


enamldef WorkspaceSettingsView(Window): win:

    initial_size = (400, 400)
    title = 'Workspace Settings'

    attr settings

    Container:
        Form:
            Label:
                text = 'Data folder'
            HGroup:
                align_widths = False
                padding = 0
                Field: data_path:
                    text << str(settings.data_path) if settings.data_path else ''
                    read_only = True
                PushButton:
                    text = 'Browse...'
                    clicked ::
                        current = str(settings.data_path) if settings.data_path else ''
                        path = FileDialogEx.get_existing_directory(self, current_path=current)
                        if path:
                            settings.data_path = Path(path)

            Label:
                text = 'Hardware'
            ObjectCombo:
                items << settings.available_hw_configurations
                selected := settings.hw_configuration

            Conditional:
                condition << settings.hw_configuration == 'Sound Card'

                Label:
                    text = 'Audio device'
                ObjectCombo:
                    items << [d['name'] for d in settings.available_devices]
                    selected := settings.selected_device

                Label:
                    pass
                Label:
                    text << settings.selected_device_info
                    foreground = '#808080'

                Label:
                    text = 'Sample rate (Hz)'
                ObjectCombo:
                    items << settings.available_sample_rates
                    selected := settings.sample_rate
                    to_string = lambda r: str(int(r)) if r else ''

        HGroup:
            leading_spacer = spacer(0)
            PushButton:
                text = 'Save'
                clicked ::
                    settings.save_config()
                    win.close()
