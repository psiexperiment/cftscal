import os
from pathlib import Path

from enaml.core.api import Conditional, Looper
from enaml.layout.api import align, hbox, spacer, vbox
from enaml.widgets.api import (
    CheckBox, Container, Label, Field, HGroup, ObjectCombo, PushButton,
    FileDialogEx, Form, Window, DockArea, DockItem, ScrollArea
)

from psi.core.enaml.api import ListDictTable


enamldef WorkspaceSettingsView(Window): win:

    initial_size = (400, 400)
    title = 'Workspace Settings'

    attr settings
    #: List of {'id': ..., 'title': ...} dicts, one per entry in
    #: TO_REGISTER -- populated by show_workspace_settings() in
    #: manifest.enaml via list_plugin_info(). Defaults to empty so the
    #: `if __name__ == '__main__':` demo in workspace.py (which builds
    #: this view without passing plugin_info) still works, just with an
    #: empty checklist.
    attr plugin_info = []

    Container:
        Form:
            Label:
                text = 'Data folder'
            HGroup:
                align_widths = False
                padding = 0
                Field: data_path:
                    text << str(settings.data_path) if settings.data_path else ''
                    read_only = True
                PushButton:
                    text = 'Browse...'
                    clicked ::
                        current = str(settings.data_path) if settings.data_path else ''
                        path = FileDialogEx.get_existing_directory(self, current_path=current)
                        if path:
                            settings.data_path = Path(path)

            Label:
                text = 'Hardware'
            ObjectCombo:
                items = ['Sound Card', 'Custom (Enaml IO manifest)']
                selected := settings.hw_mode

            Conditional:
                condition << settings.hw_mode == 'Sound Card'

                Label:
                    text = 'Audio device'
                ObjectCombo:
                    items << [d['name'] for d in settings.available_devices]
                    selected := settings.selected_device

                Label:
                    pass
                Label:
                    text << settings.selected_device_info
                    foreground = '#808080'

                Label:
                    text = 'Sample rate (Hz)'
                ObjectCombo:
                    items << settings.available_sample_rates
                    selected := settings.sample_rate
                    to_string = lambda r: str(int(r)) if r else ''

            Conditional:
                condition << settings.hw_mode == 'Custom (Enaml IO manifest)'

                Label:
                    text = 'IO manifest file'
                HGroup:
                    align_widths = False
                    padding = 0
                    Field: io_path:
                        text << settings.custom_io_path
                        read_only = True
                    PushButton:
                        text = 'Browse...'
                        clicked ::
                            current = settings.custom_io_path
                            path = FileDialogEx.get_open_file_name(
                                self, current_path=current,
                                name_filters=['*.enaml'],
                            )
                            if path:
                                settings.custom_io_path = path

                Label:
                    text = 'Manifest class'
                Field:
                    text := settings.custom_io_class

        Label:
            text = 'Always load these plugins (view-only, even without matching hardware)'

        Looper:
            iterable << plugin_info
            CheckBox:
                text = loop_item['title']
                checked << loop_item['id'] in settings.enabled_plugins
                checked ::
                    if checked:
                        if loop_item['id'] not in settings.enabled_plugins:
                            settings.enabled_plugins = settings.enabled_plugins + [loop_item['id']]
                    else:
                        settings.enabled_plugins = [
                            i for i in settings.enabled_plugins if i != loop_item['id']
                        ]

        HGroup:
            leading_spacer = spacer(0)
            PushButton:
                text = 'Save'
                clicked ::
                    settings.save_config()
                    win.close()
