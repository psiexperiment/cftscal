def _list_group_paths(base_path):
    '''
    Return sorted posix-style paths of every folder beneath ``base_path``
    that could accept a new calibration, plus ``''`` for "(root)".

    A folder is a valid target if it is:

    - An **object dir** (already contains calibration-dir children) — the
      new cal joins that object's group.
    - An **empty folder** — becomes a new object dir on the first cal.

    Org folders that already contain sub*folders* are NOT listed: filing
    a cal directly into one would create a mixed layout (a folder that's
    both org container and object dir at once), which violates the
    folder-object separation rule.  The walker still descends into such
    folders to surface their valid nested children (e.g. ``Bramhall`` is
    hidden but ``Bramhall/MMM`` is listed if MMM is an object).
    '''
    paths = ['']
    if not base_path.exists():
        return paths

    def walk(dir_):
        try:
            children = list(dir_.iterdir())
        except OSError:
            return
        for child in children:
            if not child.is_dir():
                continue
            if (child / 'metadata.json').exists():
                continue  # calibration dir
            try:
                grand_subdirs = [gc for gc in child.iterdir() if gc.is_dir()]
            except OSError:
                continue
            has_cal_grandchild = any(
                (gc / 'metadata.json').exists() for gc in grand_subdirs
            )
            rel = child.relative_to(base_path).as_posix()
            if has_cal_grandchild:
                # Object dir — pickable; new cal joins its group.
                paths.append(rel)
            elif not grand_subdirs:
                # Empty folder — pickable; becomes a new object.
                paths.append(rel)
            else:
                # Org folder with subfolders — not itself pickable, but
                # descend so its nested children can be found.
                walk(child)

    walk(base_path)
    return sorted(paths)


enamldef AddItem(PopupView): popup:

    attr combo
    window_type = 'popup'
    arrow_size = 20
    arrow_edge = 'top'
    alias label: label.text
    alias regex: field.regex

    func _add_item():
        items = combo.items[:]
        items.append(field.text)
        combo.items = items
        combo.selected = field.text
        popup.close()

    Container:
        constraints = [
            vbox(
                hbox(label, field),
                hbox(spacer(0), pb_ok, pb_cancel, spacing=0)
            ),
            align('v_center', label, field),
            align('v_center', pb_ok, pb_cancel),
            align('width', pb_ok, pb_cancel),
        ]

        Label: label:
            pass
        RegexField: field:
            regex = f'^[\w\d-]+$'
            # Only submit on Enter -- not on focus loss, since clicking
            # Cancel (or anything else) shouldn't add the typed text.
            # The client-side validator (above) blocks the submit from
            # ever updating `text` with input that fails the regex, so
            # this fires exactly when the field both validates and Enter
            # is pressed.
            submit_triggers = ['return_pressed']
            text ::
                popup._add_item()
        PushButton: pb_ok:
            text = 'OK'
            enabled << bool(field.text)
            clicked ::
                popup._add_item()

        PushButton: pb_cancel:
            text = 'Cancel'
            clicked ::
                popup.close()


class BasePlotManager(Atom):

    component = Typed(pg.GraphicsLayout)
    color_cycle = Value()
    plots = Dict()
    items = List()

    def _default_color_cycle(self):
        return iter(Tableau_20.colors)

    def _default_component(self):
        raise NotImplementedError

    def _default_plots(self):
        return {}

    def create_plot(self, color=None, width=2, line='solid'):
        if color is None:
            try:
                color = make_color(tuple(next(self.color_cycle)))
            except StopIteration:
                # We have exhausted the color cycle. Just start over again at
                # the beginning.
                self.color_cycle = self._default_color_cycle()
                color = make_color(next(self.color_cycle))
        else:
            # Coerce color back to Qcolor for use by pygtgraph
            color = make_color(color)

        linestyle = getattr(QtCore.Qt.PenStyle, f'{line.capitalize()}Line')
        pen = pg.mkPen(color, width=width, style=linestyle)
        return color, pg.PlotCurveItem(
            pen=pen,
            autoDownsample=True,
            clipToView=True,
            skipFiniteCheck=True,
        )

    def create_empty_plots(self, color=None, width=2, line='solid'):
        color, plot = self.create_plot(color=color, width=width, line=line)
        return color, [plot]

    def get_plots(self, plot_id, vb, **kw):
        if plot_id not in self.plots:
            color, plots = self.create_empty_plots(**kw)
            # Convert to Enaml color for highlight in object tree 
            color = Color(color.red(), color.green(), color.blue(),
                          color.alpha())
            self.plots[vb, plot_id] = color, plots
            for plot in plots:
                vb.addItem(plot)
        return self.plots[vb, plot_id]

    def notify(self, item, selected):
        if selected:
            return self._update(item, remove=False)
        else:
            return self._update(item, remove=True)

    def remove_plots(self, plot_id, vb):
        _, plots = self.plots.pop((vb, plot_id), (None, []))
        for plot in plots:
            vb.removeItem(plot)


class SinglePlotManager(BasePlotManager):

    vb = Typed(pg.ViewBox)
    legend = Typed(pg.LegendItem)

    x_label = Str('Frequency')
    x_units = Str('Hz')
    x_log_mode = Bool(True)
    y_label = Str('Sensitivity')
    y_units = Str('dB re 1 Vrms')

    def _default_legend(self):
        legend = pg.LegendItem()
        legend.setParentItem(self.vb)
        return legend

    def _default_vb(self):
        vb = pg.ViewBox()
        vb.setBackgroundColor('w')
        return vb

    def _default_component(self):
        component = pg.GraphicsLayout()
        component.setSpacing(10)
        y_axis = self.make_y_axis()
        x_axis = self.make_x_axis()
        component.addItem(y_axis, 0, 0)
        component.addItem(x_axis, 1, 1)

        y_axis.linkToView(self.vb)
        x_axis.linkToView(self.vb)
        component.addItem(self.vb, 0, 1)

        return component

    def make_y_axis(self):
        y_axis = pg.AxisItem('left')
        y_axis.setLabel(self.y_label, units=self.y_units)
        y_axis.setGrid(64)
        return y_axis

    def make_x_axis(self):
        x_axis = pg.AxisItem('bottom')
        x_axis.setGrid(64)
        x_axis.setLabel(self.x_label, units=self.x_units)
        x_axis.setLogMode(self.x_log_mode)
        return x_axis

    def get_plot_id(self, item):
        return item

    def _update(self, item, remove=False):
        if remove:
            self.remove_plots(item, self.vb)
            return None
        color, plots = self.get_plots(item, self.vb)
        self._plot(item, plots[0])
        return {'color': color}

    def _plot(self, item, plot):
        raise NotImplementedError

    def remove_plots(self, plot, vb=None):
        if vb is None:
            vb = self.vb
        return super().remove_plots(plot, vb)

    def get_plots(self, plot, vb=None):
        if vb is None:
            vb = self.vb
        return super().get_plots(plot, vb)


class RegionSelectViewBox(pg.ViewBox):
    '''
    A ViewBox where Ctrl+drag draws/redefines `region_select` (a
    LinearRegionItem the owning plot manager attaches after construction),
    while a plain drag still pans as usual.  Grabbing the region's own
    edge or middle handles (no modifier needed) still resizes/moves it,
    since pyqtgraph dispatches to the item under the cursor before this
    ViewBox ever sees the drag.
    '''
    region_select = None

    def mouseDragEvent(self, ev, axis=None):
        is_region_drag = (
            self.region_select is not None
            and ev.button() == QtCore.Qt.MouseButton.LeftButton
            and bool(ev.modifiers() & QtCore.Qt.KeyboardModifier.ControlModifier)
        )
        if not is_region_drag:
            super().mouseDragEvent(ev, axis=axis)
            return

        ev.accept()
        region = self.region_select
        start = self.mapSceneToView(ev.buttonDownScenePos()).x()
        current = self.mapSceneToView(ev.scenePos()).x()
        # Set both edges directly rather than region.setRegion(), which
        # unconditionally emits sigRegionChangeFinished on every call --
        # that would trigger a full PSD recompute on every intermediate
        # drag position instead of just once, at release.
        region.blockLineSignal = True
        region.lines[0].setValue(start)
        region.lines[1].setValue(current)
        region.blockLineSignal = False
        region.prepareGeometryChange()
        region.sigRegionChanged.emit(region)
        if ev.isFinish():
            region.sigRegionChangeFinished.emit(region)


class TimePSDPlotManager(BasePlotManager):

    apply_calibration = Bool(True)

    region_select = Value()
    time_vb = Value()
    psd_vb = Value()
    data = Value()

    analysis = List()

    def _default_component(self):
        component = pg.GraphicsLayout()
        component.setSpacing(10)

        # Set up time series viewbox
        x_axis = pg.AxisItem('bottom')
        x_axis.setGrid(64)
        x_axis.setLabel('Time', units='s')
        y_axis = pg.AxisItem('left')
        if self.apply_calibration:
            y_axis.setLabel('Signal (Pa)')
        else:
            y_axis.setLabel('Signal (V)')
        y_axis.setGrid(64)
        self.time_vb = vb = RegionSelectViewBox()
        vb.setBackgroundColor('w')
        y_axis.linkToView(vb)
        x_axis.linkToView(vb)
        component.addItem(y_axis, 0, 0)
        component.addItem(x_axis, 1, 1)
        component.addItem(vb, 0, 1)

        # Set up time series viewbox
        x_axis = pg.AxisItem('bottom')
        x_axis.setGrid(64)
        x_axis.setLabel('Frequency', units='Hz')
        x_axis.setLogMode(True)
        y_axis = pg.AxisItem('left')
        y_axis.setGrid(64)
        if self.apply_calibration:
            y_axis.setLabel('PSD (dB SPL)')
        else:
            y_axis.setLabel('PSD (dB re 1 Vrms)')

        self.psd_vb = vb = pg.ViewBox()
        vb.setBackgroundColor('w')
        y_axis.linkToView(vb)
        x_axis.linkToView(vb)
        component.addItem(y_axis, 2, 0)
        component.addItem(x_axis, 3, 1)
        component.addItem(vb, 2, 1)

        self.data = {}

        return component

    def _y_transform(self, y, fs):
        return y

    def _update_analysis(self):
        if self.region_select is None:
            return
        xlb, xub = self.region_select.getRegion()
        info = []

        for item, d in self.data.items():
            x, y, fs, cal = d['x'], d['y'], d['fs'], d['calibration']
            m = (x >= xlb) & (x < xub)
            if m.any():
                # Drop the DC component since this cannot be shown on log
                # scales and affects the autorange.
                y = self._y_transform(y[m], fs)
                pa = cal.get_level(util.psd_df(y, fs=fs)).iloc[1:]
                db = util.patodb(pa)
                d['psd_plot'][0].setData(np.log10(db.index.values), db.values)
                y_cal = cal.get_level(y)
                info.append({
                    'color': d['color'],
                    'run': str(item),
                    'pe': util.patodb(np.ptp(y_cal) * 0.5),
                    'rms': util.patodb(util.rms(y_cal)),
                    'duration': x[m].max() - x[m].min(),
                })
            else:
                d['psd_plot'][0].setData([], [])
                info.append({
                    'color': d['color'],
                    'run': str(item),
                    'pe': np.nan,
                    'rms': np.nan,
                    'duration': 0,
                })
        self.analysis = info

    def _default_region_select(self):
        # Ctrl+drag on the time plot (see RegionSelectViewBox) draws or
        # redefines the region from scratch; grabbing an existing edge or
        # the middle (no modifier needed) resizes/moves it. PSD/analysis
        # only recomputes once a drag finishes (sigRegionChangeFinished),
        # not on every intermediate position during the drag -- pyqtgraph
        # handles the live visual update of the region itself efficiently
        # on its own.
        region = pg.LinearRegionItem(values=(0, 0), movable=True)
        region.setZValue(10)
        # sigRegionChangeFinished emits the region item itself as an arg;
        # _update_analysis reads the current bounds via self.region_select
        # directly and doesn't need it.
        region.sigRegionChangeFinished.connect(lambda _: self._update_analysis())
        self.time_vb.addItem(region, ignoreBounds=True)
        self.time_vb.region_select = region
        return region

    def remove(self, recording):
        self._update(recording, True)

    def _update(self, item, remove=False):
        if remove:
            self.remove_plots(item, self.time_vb)
            self.remove_plots(item, self.psd_vb)
            self.data.pop(item, None)
            self._update_analysis()
            return

        color, time_plot = self.get_plots(item, self.time_vb)
        _, psd_plot = self.get_plots(item, self.psd_vb, color=color)
        self.data[item] = self._plot(item, time_plot, psd_plot)
        self.data[item]['color'] = color
        self._update_analysis()
        return {'color': color}


################################################################################
# Organize list of calibrated objects and calibrations for each object
################################################################################
class MultiPlotManager(Atom):
    '''
    Allow multiple plot managers to receive notifications
    '''
    managers = Tuple()

    def __init__(self, *managers):
        super().__init__(managers=managers)

    def plot(self, calibration):
        results = []
        for manager in self.managers:
            result = manager.plot(calibration)
            results.append(result)
        return results[0]

    def remove(self, calibration):
        results = []
        for manager in self.managers:
            result = manager.remove(calibration)
            results.append(result)
        return results[0]


enamldef CalibratedObjects(Container): container:
    alias collection: tree.collection
    alias mapping: tree.mapping

    FastTreeView: tree:
        pass


enamldef GroupPathPicker(HGroup): picker:
    '''
    Folder-picker for the plugin's calibration target folder.

    Attrs:

    - ``plugin_settings`` — the CalibrationSettings instance; provides
      ``data_path`` so the picker can walk the plugin's subfolder tree.
    - ``subfolder`` — the plugin's on-disk subfolder name ("microphone",
      "speaker", …).
    - ``collection`` — optional ObjectCollection whose ``updated`` event
      triggers a dropdown refresh (e.g. after the user creates a folder
      via the tree view's right-click menu).
    - ``path_target`` — the object whose ``group_path`` attribute the
      picker reads and writes.  Defaults to ``plugin_settings`` (single
      shared target per plugin).  Plugins that want the target folder to
      switch per input channel pass e.g. ``path_target << settings.
      selected_input`` — then re-selecting an input rebinds the picker
      to that input's saved group_path.
    '''
    attr plugin_settings
    attr subfolder = ''
    attr collection = None
    attr path_target << plugin_settings
    attr show_label = True

    share_layout = True
    align_widths = False
    padding = 0
    spacing = 5

    activated ::
        if collection is not None:
            collection.observe(
                'updated',
                lambda change: setattr(
                    select, 'items',
                    _list_group_paths(plugin_settings.data_path / subfolder),
                ),
            )

    Conditional:
        condition << show_label

        Label:
            text = 'Target folder'

    ObjectCombo: select:
        items = _list_group_paths(plugin_settings.data_path / subfolder)
        selected := path_target.group_path
        to_string = lambda x: '(root)' if not x else x


enamldef SensorView(HGroup):

    attr sensor
    attr mode = 'static'
    attr label = 'Sensor'
    attr show_label = True
    attr gains = [-20, -10, 0, 10, 20, 30, 40, 50]
    attr gain_unit = 'db gain'
    #: Optional ObjectCollection whose ``updated`` event triggers a
    #: dropdown refresh — same pattern as GroupPathPicker.  When a new
    #: calibration lands, sensor.refresh_available() re-merges the
    #: picker list from disk without needing a plugin reload.
    attr collection = None

    share_layout = True
    align_widths = False
    padding = 0
    spacing = 5

    #: Named handler so the observer setup reads cleanly and the
    #: closure semantics are explicit: ``sensor`` is looked up in the
    #: enamldef scope at call time, so a rebind (user selects a
    #: different input) automatically routes to the new sensor.  Enaml
    #: doesn't give us a clean destroy hook on HGroup; observers on
    #: ``collection`` linger until Python's cyclic GC collects the
    #: torn-down widget, which is fine in practice.
    func _on_collection_updated(change):
        if hasattr(sensor, 'refresh_available'):
            sensor.refresh_available()

    initialized ::
        if collection is not None:
            collection.observe('updated', _on_collection_updated)

    Conditional:
        condition << show_label

        Label:
            text = label

    ObjectCombo: select:
        items := sensor.available_references
        selected := sensor.name

    Conditional:
        condition = mode != 'static'

        PushButton: add:
            text = '+'
            constraints = [width == 25]
            clicked ::
                # Reference identifiers are calibration paths (e.g.
                # "Bramhall/MMM"), so widen the regex to accept slashes.
                popup = AddItem(
                    self, combo=select, label=label,
                    regex=r'^[\w\d/_\- ]+$',
                )
                popup.show()

    ObjectCombo:
        items = gains
        selected := sensor.gain

    Label:
        text = gain_unit


enamldef InputAmplifierView(VGroup):

    alias sensor: sensor_view.sensor
    alias mode: sensor_view.mode
    alias label: sensor_view.label
    share_layout = True
    padding = 0
    spacing = 5

    HGroup:
        share_layout = True
        align_widths = False
        padding = 0
        spacing = 5

        SensorView: sensor_view:
            gains = [5, 10, 20, 50, 100, 200]
            gain_unit = 'x'

        ObjectCombo: amp_gain_mult:
            items = [10, 1000]
            selected := sensor.gain_mult

    HGroup:
        share_layout = True
        align_widths = False
        padding = 0
        spacing = 5

        ObjectCombo: amp_freq_lb:
            items = [0, 0.1, 0.3, 1, 3, 10, 30, 100, 300]
            selected := sensor.freq_lb

        Label: amp_freq_lb_label:
            text = 'Hz to'

        ObjectCombo: amp_freq_ub:
            items = [0.03, 0.1, 0.3, 1, 3, 10]
            selected ::
                sensor.freq_ub = selected * 1e3
            selected << sensor.freq_ub * 1e-3

        Label: amp_freq_ub_label:
            text = 'kHz, 60 Hz'

        ObjectCombo: amp_filt_60Hz:
            items = ['input', 'output']
            selected := sensor.filt_60Hz


enamldef GeneratorView(HGroup):

    attr generator
    attr mode = 'static'
    attr label = 'Generator'
    attr show_label = True
    share_layout = True
    align_widths = False
    padding = 0
    spacing = 5

    Conditional:
        condition << show_label

        Label:
            text = label

    ObjectCombo: select:
        items := generator.available_generators
        selected := generator.name

    Conditional:
        condition = mode != 'static'

        PushButton: add:
            text = '+'
            constraints = [width == 25]
            clicked ::
                popup = AddItem(self, combo=select, label=label)
                popup.show()
