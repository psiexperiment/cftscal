    ObjectCollection, GeneratorView, SensorView,
)


def a_weighting_sos(fs):
    '''
    Digital A-weighting filter, as second-order sections.

    Implements the standard IEC 61672-1 A-weighting curve (the same
    frequency weighting used by calibrated sound level meters) via the
    analog pole/zero definition, converted to a digital filter with the
    bilinear transform. Accuracy degrades somewhat above ~10 kHz at
    lower sample rates (a known characteristic of the bilinear
    transform near Nyquist); this is negligible at the low end, which
    is what matters for filtering out sub-20 Hz rumble.

    Parameters
    ----------
    fs : float
        Sampling rate, in Hz.

    Returns
    -------
    sos : np.ndarray
        Second-order sections suitable for `scipy.signal.sosfiltfilt`.
    '''
    f1, f2, f3, f4 = 20.598997, 107.65265, 737.86223, 12194.217
    zeros = np.array([0, 0, 0, 0])
    poles = -2 * np.pi * np.array([f1, f1, f4, f4, f2, f3])
    # Normalize so the analog response is 0 dB (gain 1) at 1 kHz, per the
    # standard.
    b, a = signal.zpk2tf(zeros, poles, 1)
    _, h = signal.freqs(b, a, [2 * np.pi * 1000])
    k = 1 / abs(h[0])
    z_d, p_d, k_d = signal.bilinear_zpk(zeros, poles, k, fs)
    return signal.zpk2sos(z_d, p_d, k_d)


class InputRecordingPlotManager(TimePSDPlotManager):

    #: 'dBZ' is an unfiltered passthrough ("Z-weighting" is the standard
    #: term for "no frequency weighting"). 'dBA' applies the standard
    #: A-weighting curve. '1/3 Octave' is a steep bandpass centered on
    #: `filter_fc`, for pulling a single low-level test tone out of
    #: broadband noise (e.g. building rumble below 20 Hz) that would
    #: otherwise swamp it.
    filter_mode = Enum('dBZ', 'dBA', '1/3 Octave')

    #: Center frequency for '1/3 Octave' mode, in Hz.
    filter_fc = Float(1000)

    #: Filter order ("steepness") for '1/3 Octave' mode -- higher orders
    #: roll off more steeply outside the passband.
    filter_order = Int(4)

    def _observe_filter_mode(self, event):
        self._update_all()

    def _observe_filter_fc(self, event):
        self._update_all()

    def _observe_filter_order(self, event):
        self._update_all()

    def _update_all(self):
        if self.data is None:
            return
        for item_data in self.data.values():
            self._update_plot(**item_data)

    def _update_plot(self, x, y, fs, calibration, time_plot, psd_plot,
                     **kwargs):
        y = self._y_transform(y, fs)
        y = calibration.get_level(y)
        time_plot[0].setData(x, y)

    def _y_transform(self, y, fs):
        if self.filter_mode == 'dBZ':
            return y
        if self.filter_mode == 'dBA':
            sos = a_weighting_sos(fs)
        else:
            fl, fh = util.octave_band_freqs(self.filter_fc, 1 / 3)
            sos = signal.iirfilter(self.filter_order, (fl, fh), btype='bandpass',
                                   fs=fs, output='sos')
        return signal.sosfiltfilt(sos, y)

    def _plot(self, item, time_plot, psd_plot):
        fh = item.load()
        y = fh.selected_input[0]
        fs = fh.selected_input.fs
        x = np.arange(len(y)) / fs
        if not self.apply_calibration:
            cal = FlatCalibration.unity()
        else:
            cal = fh.selected_input.get_calibration()

        data = {
            'time_plot': time_plot,
            'psd_plot': psd_plot,
            'x': x,
            'y': y,
            'fs': fs,
            'calibration': cal,
        }
        self._update_plot(**data)
        return data


enamldef InputRecordingView(Container):

    attr settings

    DockArea: area:
        layout = AreaLayout(
            HSplitLayout(
                VSplitLayout(
                    'settings',
                    'input_list',
                    'input_analysis',
                    sizes=[25, 200, 50],
                ),
                'input_recording_plot',
                sizes=[250, 900],
            ),
        )
        DockItem:
            name = 'settings'
            title = 'Settings'
            closable = False
            stretch = 0

            Conditional:
                condition << settings is None

                Container:
                    Label:
                        text = 'No inputs found on system. View mode only.'

            Conditional:
                condition << settings is not None

                Container:
                    layout_constraints => ():
                        # For some reason aligning right edge of first widget
                        # (label) does not produce nicely-aligned widgets, so we
                        # align the left edge of second widget.
                        widgets = self.visible_widgets()
                        second = [w.visible_widgets()[1] for w in widgets if isinstance(w, HGroup)]
                        constraints = [
                            vbox(
                                *widgets[:-1],
                                hbox(spacer(0), widgets[-1]),
                                spacing=0,
                            ),
                            align('left', *second),
                        ]
                        return constraints

                    HGroup:
                        share_layout = True
                        align_widths = False
                        padding = 0
                        spacing = 5

                        Label:
                            text = 'Input Channel'

                        ObjectCombo:
                            items = settings.available_inputs
                            selected := settings.selected_input
                            to_string = lambda m: m.input_label

                    GroupPathPicker:
                        plugin_settings = settings
                        subfolder = 'input-recording'
                        collection << input_tree.collection
                        # Per-channel target folder — switching input
                        # channels swaps in that channel's saved folder.
                        path_target << settings.selected_input

                    SensorView:
                        sensor << settings.selected_input.sensor
                        collection << input_tree.collection

                    GeneratorView:
                        generator << settings.generator
                        mode = 'add'

                    PushButton: start:
                        text = 'Record'
                        enabled << (
                            bool(settings.selected_input.sensor.name) and
                            bool(settings.generator.name)
                        )
                        clicked ::
                            settings.run_input_recording(settings.selected_input)
                            input_tree.collection.update_groups()

        DockItem:
            name = 'input_recording_plot'
            title = 'Input Recording'
            closable = False
            stretch = 10

            Container:
                HGroup:
                    align_widths = False
                    trailing_spacer = spacer(0)
                    Label:
                        text = 'Filter'
                    ObjectCombo:
                        items = ['dBZ', 'dBA', '1/3 Octave']
                        selected := input_recording_plot.manager.filter_mode

                    Conditional:
                        condition << input_recording_plot.manager.filter_mode == '1/3 Octave'

                        Label:
                            text = 'Center freq.'
                        FloatField:
                            value := input_recording_plot.manager.filter_fc
                        Label:
                            text = 'Hz, order'
                        IntField:
                            value := input_recording_plot.manager.filter_order

                PGCanvas: input_recording_plot:
                    attr manager = InputRecordingPlotManager(apply_calibration=True)
                    component << manager.component

        DockItem:
            name = 'input_list'
            title = 'Recordings'
            closable = False
            stretch = 0

            CalibratedObjects: input_tree:
                mapping = {
                    'Name': {
                        'groupby': True,
                        'id': True,
                        'to_str': lambda x: x.name,
                    },
                    'Date': {
                        'groupby': False,
                        'id': True,
                        'to_str': lambda x: str(x.datetime),
                    },
                    'Generator': {
                        'to_str': lambda x: x.generator,
                    },
                    'Sensor': {
                        'to_str': lambda x: x.sensor,
                    },
                }

                collection = ObjectCollection(
                    input_recording_manager,
                    [input_recording_plot.manager],
                )

        DockItem:
            name = 'input_analysis'
            title = 'Analysis'
            closable = False

            Container:
                ListDictTable:
                    stretch_last_section = False
                    data << input_recording_plot.manager.analysis
                    columns = ['duration', 'pe', 'rms']
                    column_info = {
                        'duration': {
                            'label': 'Dur (s)',
                            'to_string': lambda x: '{:.2f}'.format(x),
                            'width': 20,
                        },
                        'pe': {
                            'label': 'pe SPL',
                            'to_string': lambda x: '{:.1f}'.format(x),
                            'width': 20,
                        },
                        'rms': {
                            'label': 'dB SPL',
                            'to_string': lambda x: '{:.1f}'.format(x),
                            'width': 20,
                        },
                    }

                    get_cell_color => (row, column):
                        if column != 0:
                            return 'white'
                        return data[row]['color']
