def region_levels(y, y_a):
    '''
    The Analysis table's measurements for one channel's selected region.

    Parameters
    ----------
    y : np.ndarray
        The region in pascals, after the Filter setting.
    y_a : np.ndarray
        The same region in pascals, A-weighted from the unfiltered region
        (so dBA doesn't depend on the Filter setting) -- the same way the
        'dBA' Filter would, so the dBA row matches that trace.

    Returns
    -------
    levels : dict
        ``peak``: half the peak-to-peak, in dB SPL (labelled "Peak SPL");
        ``pe``: peak-equivalent SPL, the RMS of a sine with the same
        peak-to-peak -- equal to the RMS level for a pure tone; ``rms``:
        RMS level, dB SPL; ``dba``: A-weighted RMS level; ``max_pa`` /
        ``min_pa``: most positive and most negative sample, in Pa.
    '''
    half_ptp = np.ptp(y) * 0.5
    return {
        'peak': util.patodb(half_ptp),
        'pe': util.patodb(half_ptp / np.sqrt(2)),
        'rms': util.patodb(util.rms(y)),
        'dba': util.patodb(util.rms(y_a)),
        'max_pa': np.max(y),
        'min_pa': np.min(y),
    }


#: Keys of region_levels(), for an empty region's row.
_LEVEL_KEYS = ('peak', 'pe', 'rms', 'dba', 'max_pa', 'min_pa')

#: Rows of the Analysis table, top to bottom: (key in a manager.analysis
#: entry, row label, format). The first row is a strip of each recording's
#: plot color, with no text.
ANALYSIS_ROWS = [
    ('color', '', None),
    ('duration', 'Dur (s)', '{:.2f}'),
    ('rms', 'dB SPL', '{:.1f}'),
    ('dba', 'dBA', '{:.1f}'),
    ('pe', 'peSPL', '{:.1f}'),
    ('peak', 'Peak SPL', '{:.1f}'),
    ('max_pa', 'Max (Pa)', '{:.3f}'),
    ('min_pa', 'Min (Pa)', '{:.3f}'),
]


def transpose_analysis(analysis):
    '''
    Lay out the Analysis table with one row per measurement and one column
    per recorded channel, so channels being compared sit side by side and
    the table fits the panel's height rather than overflowing its width.

    Parameters
    ----------
    analysis : list of dict
        InputRecordingPlotManager.analysis: one entry per recorded channel,
        with 'recording', 'channel' and the ANALYSIS_ROWS keys.

    Returns
    -------
    rows : list of dict
        One dict per ANALYSIS_ROWS entry, mapping each column's key
        ('c0', 'c1', ...) to its text. Empty when nothing is plotted.
    column_info : dict
        Each column's header ("<channel>", newline, "<recording time>").
    '''
    if not analysis:
        return [], {}
    keys = [f'c{i}' for i in range(len(analysis))]
    rows = []
    for name, label, fmt in ANALYSIS_ROWS:
        row = {}
        for key, entry in zip(keys, analysis):
            value = entry.get(name)
            if fmt is None:
                row[key] = ''
            elif value is None or np.isnan(value):
                row[key] = '\u2013'
            else:
                row[key] = fmt.format(value)
        rows.append(row)
    column_info = {
        # Concatenation: enaml keeps a backslash escape in an f-string
        # literally (see CLAUDE.md).
        key: {'label': entry['channel'] + '\n' + entry['recording'],
              }
        for key, entry in zip(keys, analysis)
    }
    return rows, column_info


#: Bandwidths offered for 'Band-pass' mode, in octaves, with their labels.
BANDWIDTHS = {1/3: '1/3', 1/2: '1/2', 1: '1', 2: '2', 3: '3', 4: '4'}


#: Line styles create_plot() can resolve (its `f'{line.capitalize()}Line'`
#: lookup into QtCore.Qt.PenStyle only round-trips single-word names --
#: 'dashdot'.capitalize() -> 'Dashdot', but the real Qt enum member is
#: 'DashDotLine', so anything beyond these three raises AttributeError.
_CHANNEL_LINE_STYLES = ('solid', 'dash', 'dot')


class InputRecordingPlotManager(TimePSDPlotManager):

    #: 'Unfiltered' is a raw passthrough -- deliberately not called 'dBZ'
    #: ("Z-weighting"), since that name implies a standardized flat
    #: response over a defined range (nominally 10 Hz-20 kHz per IEC
    #: 61672-1), and this mode makes no such claim: it's whatever
    #: bandwidth the raw recording happens to have, unfiltered. 'dBA'
    #: applies the standard A-weighting curve. 'Band-pass' keeps the band
    #: `filter_bw` octaves wide centered on `filter_fc` -- at its default
    #: of 1/3 octave, steep enough to pull a single low-level test tone
    #: out of broadband noise (e.g. building rumble below 20 Hz) that
    #: would otherwise swamp it. 'High-pass' (the default) removes
    #: everything below `highpass_fc` -- like the high-pass switch on a
    #: microphone power module such as the GRAS 12AQ -- so building rumble
    #: and handling noise don't inflate the level.
    filter_mode = Enum('High-pass', 'Unfiltered', 'dBA', 'Band-pass')

    #: One shared color per recording (item), keyed by item -- assigned
    #: lazily from the same color_cycle create_plot() draws from, but
    #: reserved once per item instead of once per (item, channel) plot.
    #: This is what lets every channel belonging to one recording share
    #: a single color that also matches the tree's highlight for that
    #: recording; individual channels within a recording are told apart
    #: by line style (_CHANNEL_LINE_STYLES) instead of by color.
    item_colors = Dict()

    #: Center frequency for 'Band-pass' mode, in Hz.
    filter_fc = Float(1000)

    #: Bandwidth for 'Band-pass' mode, in octaves (one of BANDWIDTHS).
    #: 1000 Hz and 4 octaves (250 Hz to 4 kHz) has the band edges of the
    #: band-pass in the lab's older MATLAB tool, measure_sound -- not its
    #: shape (order 1, run with filtfilt).
    filter_bw = Float(1/3)

    #: Filter order ("steepness") for 'Band-pass' mode -- higher orders
    #: roll off more steeply outside the passband.
    filter_order = Int(4)

    #: Cutoff for 'High-pass' mode, in Hz.
    highpass_fc = Float(20)

    #: Longest stretch of the time plot shown when recordings are plotted,
    #: in seconds -- like the lab's older MATLAB tool, measure_sound, which
    #: opens on the first 90 s. Pan or zoom out to see the rest.
    initial_window = Float(90)

    #: Butterworth order for 'High-pass' mode. The default matches the
    #: GRAS 12AQ's HP filter: 3-pole Butterworth, -3 dB at 20 Hz (18 dB
    #: per octave below it).
    highpass_order = Int(3)

    #: If False (the default), filter causally, as an analog filter (the
    #: 12AQ's high-pass, a sound level meter's A-weighting) would, phase
    #: shift and all. If True, apply the same magnitude response with no
    #: phase shift: levels are unchanged, but the waveform isn't delayed
    #: or reshaped (which can change peak values), at the cost of energy
    #: appearing before an onset. Applies to every Filter and to the dBA row.
    zero_phase = Bool(False)

    #: If True, A-weight with the exact IEC 61672-1 curve applied in the
    #: frequency domain; if False (the default), with the bilinear-transform
    #: IIR filter, which is cheaper but falls short of the curve towards
    #: Nyquist (6.4 dB low at 16 kHz when sampling at 48 kHz). Applies to
    #: the dBA Filter and the dBA row.
    exact_a_weighting = Bool(False)

    def _observe_zero_phase(self, event):
        self._update_all()

    def _observe_exact_a_weighting(self, event):
        self._update_all()

    def _observe_filter_mode(self, event):
        self._update_all()

    def _observe_filter_fc(self, event):
        self._update_all()

    def _observe_filter_bw(self, event):
        self._update_all()

    def _observe_filter_order(self, event):
        self._update_all()

    def _observe_highpass_fc(self, event):
        self._update_all()

    def _observe_highpass_order(self, event):
        self._update_all()

    def _update_all(self):
        if self.data is None:
            return
        for item_data in self.data.values():
            self._update_plot(**item_data)
        # Without this, changing filter_mode/filter_fc/filter_order only
        # updated the time-domain curves (above) -- the PSD plot is
        # computed and drawn entirely inside _update_analysis(), which
        # these observers never called.
        self._update_analysis()

    def _update_plot(self, x, y, fs, calibration, time_plot, psd_plot,
                     **kwargs):
        y = self._y_transform(y, fs)
        y = calibration.get_level(y)
        time_plot[0].setData(x, y)

    def _a_weight(self, y, fs):
        '''A-weight ``y`` as the dBA Filter and the dBA row do.'''
        return a_weight(y, fs, zero_phase=self.zero_phase,
                        exact=self.exact_a_weighting)

    def _y_transform(self, y, fs):
        # Whether causal or zero-phase, every filter applies its designed
        # magnitude response once -- never sosfiltfilt, which applies it
        # twice (see cftscal.plugins.input_recording.filters).
        if self.filter_mode == 'Unfiltered':
            return y
        if self.filter_mode == 'dBA':
            return self._a_weight(y, fs)
        elif self.filter_mode == 'High-pass':
            sos = signal.butter(self.highpass_order, self.highpass_fc,
                                btype='highpass', fs=fs, output='sos')
        else:
            fl, fh = util.octave_band_freqs(self.filter_fc, self.filter_bw)
            sos = signal.iirfilter(self.filter_order, (fl, fh), btype='bandpass',
                                   fs=fs, output='sos')
        return sos_filter(sos, y, fs, self.zero_phase)

    def _channels(self, item):
        # Authoritative list of what was actually recorded -- correct for
        # both old (single, fixed 'selected_input' array) and new
        # (multi-channel) recordings via CFTSInputRecording.sensors' own
        # back-compat shim.
        return list(item.sensors)

    def _item_color(self, item):
        if item not in self.item_colors:
            # create_plot() draws the next color_cycle color; we only
            # want the color, so the PlotDataItem it also builds is
            # discarded -- it's never added to a view.
            color, _ = self.create_plot()
            self.item_colors[item] = color
        return self.item_colors[item]

    def _channel_line_style(self, channel_index):
        return _CHANNEL_LINE_STYLES[channel_index % len(_CHANNEL_LINE_STYLES)]

    def _update(self, item, remove=False):
        if remove:
            for channel in self._channels(item):
                key = (item, channel)
                self.remove_plots(key, self.time_vb)
                self.remove_plots(key, self.psd_vb)
                self.data.pop(key, None)
            self.item_colors.pop(item, None)
            self._show_initial_window()
            self._update_analysis()
            return

        fh = item.load()
        item_color = self._item_color(item)
        resolved_color = None
        for i, channel in enumerate(self._channels(item)):
            key = (item, channel)
            line = self._channel_line_style(i)
            color, time_plot = self.get_plots(key, self.time_vb, color=item_color, line=line)
            _, psd_plot = self.get_plots(key, self.psd_vb, color=item_color, line=line)
            self.data[key] = self._plot(channel, fh, time_plot, psd_plot)
            self.data[key]['color'] = color
            if resolved_color is None:
                # get_plots() converts to an enaml.colors.Color for tree
                # highlighting (see BasePlotManager.get_plots); item_color
                # itself is still the raw QColor create_plot() returned,
                # so hand back this converted value instead -- every
                # channel resolves to the same RGBA anyway since they all
                # share item_color as their input.
                resolved_color = color
        self._show_initial_window()
        self._update_analysis()
        # One color per recording (item), shared by every channel it
        # fans out to -- this is what the tree node's highlight, every
        # channel's plot curve, and every one of that recording's rows
        # in the analysis table all now have in common.
        return {'color': resolved_color}

    def _update_analysis(self):
        # Deliberate near-duplicate of TimePSDPlotManager._update_analysis
        # rather than a shared helper -- self.data is keyed by (item,
        # channel) tuples here instead of by item, and each analysis row
        # needs its own 'recording'/'channel' fields instead of
        # TimePSDPlotManager's 'run': str(item).
        if self.region_select is None:
            return
        xlb, xub = self.region_select.getRegion()
        info = []

        # Group rows by recording so a recording's channels render as
        # consecutive rows sharing one color swatch -- the same color
        # used to highlight that recording in the tree. Individual
        # channels within a group are told apart by the 'channel'
        # column (and by line style in the plot), not by a separate
        # swatch.
        grouped = {}
        for (item, channel), d in self.data.items():
            grouped.setdefault(item, []).append((channel, d))

        for item, channels in grouped.items():
            for channel, d in channels:
                # The 'channel' column shows the human-readable label
                # (e.g. "Ch 2"), not the raw hardware channel name (e.g.
                # "ai2") used as the dict key -- see
                # CFTSInputRecording.sensors.
                channel_label = item.sensors[channel]['label']
                x, y, fs, cal = d['x'], d['y'], d['fs'], d['calibration']
                m = (x >= xlb) & (x < xub)
                row = {
                    'color': d['color'],
                    'recording': str(item.datetime),
                    'channel': channel_label,
                    # What Play region plays when this column is selected.
                    'source': (item, channel),
                }
                if m.any():
                    # Drop the DC component since this cannot be shown on
                    # log scales and affects the autorange.
                    y_region = y[m]
                    y = self._y_transform(y_region, fs)
                    pa = cal.get_level(util.psd_df(y, fs=fs)).iloc[1:]
                    db = util.patodb(pa)
                    d['psd_plot'][0].setData(np.log10(db.index.values), db.values)
                    row['duration'] = x[m].max() - x[m].min()
                    if self.filter_mode == 'dBA':
                        y_a = y
                    else:
                        y_a = self._a_weight(y_region, fs)
                    row.update(region_levels(cal.get_level(y), cal.get_level(y_a)))
                else:
                    d['psd_plot'][0].setData([], [])
                    row['duration'] = 0
                    row.update(dict.fromkeys(_LEVEL_KEYS, np.nan))
                info.append(row)
        self.analysis = info

    def _show_initial_window(self):
        '''
        Show at most the first `initial_window` seconds of the time plot.

        Recordings no longer than that still fill the plot (pyqtgraph's
        auto-range); a longer one starts on its first `initial_window`
        seconds rather than squeezing every second into the plot. Done
        whenever a recording is ticked or unticked, so it overrides any
        zooming done before.
        '''
        lengths = [d['x'][-1] for d in self.data.values() if len(d['x'])]
        if lengths and max(lengths) > self.initial_window:
            self.time_vb.setXRange(0, self.initial_window, padding=0)
        else:
            self.time_vb.enableAutoRange(x=True)

    def region_signals(self):
        '''
        The selected region of every plotted recording, as plotted: in
        pascals, after the Filter. What Export region and Play region use.

        Returns
        -------
        regions : list of dict
            One per recording that the region overlaps: 'item' (the
            recording), 'channels' (list of (channel, samples)), 'fs' and
            'region' ((start, end) in seconds).
        '''
        if self.region_select is None or not self.data:
            return []
        xlb, xub = sorted(self.region_select.getRegion())
        regions = {}
        for (item, channel), d in self.data.items():
            m = (d['x'] >= xlb) & (d['x'] < xub)
            if not m.any():
                continue
            y = d['calibration'].get_level(self._y_transform(d['y'][m], d['fs']))
            entry = regions.setdefault(item, {
                'item': item, 'channels': [], 'fs': d['fs'],
                'region': (float(xlb), float(xub)),
            })
            entry['channels'].append((channel, y))
        return list(regions.values())

    def channel_region(self, source):
        '''
        One channel's region, as for region_signals: ``(samples, fs)``, or
        None if the region doesn't overlap it. ``source`` is an analysis
        entry's 'source', (recording, channel).
        '''
        item, channel = source
        for entry in self.region_signals():
            if entry['item'] is item:
                for name, y in entry['channels']:
                    if name == channel:
                        return y, entry['fs']
        return None

    def filter_settings(self):
        '''The current Filter, as saved in an exported region's metadata.'''
        settings = {'mode': self.filter_mode}
        if self.filter_mode != 'Unfiltered':
            settings['zero_phase'] = self.zero_phase
        if self.filter_mode == 'dBA':
            settings['a_weighting'] = 'exact' if self.exact_a_weighting else 'bilinear'
        elif self.filter_mode == 'High-pass':
            settings.update(cutoff_hz=self.highpass_fc, order=self.highpass_order)
        elif self.filter_mode == 'Band-pass':
            settings.update(center_hz=self.filter_fc, width_octaves=self.filter_bw,
                            order=self.filter_order)
        return settings

    def _plot(self, channel, fh, time_plot, psd_plot):
        sig = getattr(fh, channel)
        y = sig[0]
        fs = sig.fs
        x = np.arange(len(y)) / fs
        if not self.apply_calibration:
            cal = FlatCalibration.unity()
        else:
            cal = sig.get_calibration()

        data = {
            'time_plot': time_plot,
            'psd_plot': psd_plot,
            'x': x,
            'y': y,
            'fs': fs,
            'calibration': cal,
            'channel': channel,
        }
        self._update_plot(**data)
        return data


def has_region(analysis):
    '''Whether the selected region overlaps any plotted recording.'''
    return any(entry['duration'] > 0 for entry in analysis)


def region_metadata(entry, filter_settings):
    '''
    Metadata embedded in an exported region's WAV file.

    Parameters
    ----------
    entry : dict
        One of InputRecordingPlotManager.region_signals().
    filter_settings : dict
        InputRecordingPlotManager.filter_settings().
    '''
    item = entry['item']
    channels = [channel for channel, _ in entry['channels']]
    return {
        'region': list(entry['region']),
        'filter': filter_settings,
        'units': 'Pa',
        'channels': channels,
        'sensors': {c: item.sensors[c] for c in channels},
        'generator': item.generator,
        'datetime': item.datetime.isoformat(),
        'recording': str(item.filename),
    }


def export_regions(folder, regions, filter_settings):
    '''
    Export each recording's region (InputRecordingPlotManager.
    region_signals()) to its own WAV file in ``folder``; return the paths.
    Plain Python: enaml func blocks can't hold generator expressions.
    '''
    return [
        export_region(folder, entry['item'].filename.name,
                      [y for _, y in entry['channels']], entry['fs'],
                      region_metadata(entry, filter_settings))
        for entry in regions
    ]


enamldef InputRecordingView(Container):

    attr settings

    #: Plays the selected region (see region.Player).
    attr player = Player()

    func export_selected_region():
        regions = input_recording_plot.manager.region_signals()
        if not regions:
            return
        folder = FileDialogEx.get_existing_directory(
            self, current_path=str(input_recording_manager.loaders[0].base_path)
            if input_recording_manager.loaders else '')
        if not folder:
            return
        paths = export_regions(
            folder, regions, input_recording_plot.manager.filter_settings())
        information(self, 'Region exported',
                    f'Saved {len(paths)} file(s) to {folder}: '
                    + ', '.join([path.name for path in paths]))

    func play_selected_region():
        if player.playing:
            player.stop()
            return
        analysis = input_recording_plot.manager.analysis
        coords = analysis_table.selected_coords
        column = coords[0][1] if coords else 0
        if not 0 <= column < len(analysis):
            return
        found = input_recording_plot.manager.channel_region(analysis[column]['source'])
        if found is None:
            warning(self, 'Cannot play',
                    'The selected region does not overlap that recording.')
            return
        y, fs = found
        peak = clipping_peak(y)
        if peak is not None:
            answer = question(
                self, 'Playback will clip',
                f'This region peaks at {peak:.1f} Pa ({peak_db(peak):.1f} dB SPL), '
                f'above the {PLAYBACK_FULL_SCALE_PA:g} Pa that plays at full '
                f'volume, so it will be distorted. Play it anyway?')
            if answer is None or answer.action != 'accept':
                return
        try:
            player.play(y, fs)
        except ImportError:
            warning(self, 'Cannot play',
                    'Playback needs the sounddevice package (pip install sounddevice).')
        except Exception as e:
            warning(self, 'Cannot play', f'The sound output could not play it: {e}')

    DockArea: area:
        layout = AreaLayout(
            HSplitLayout(
                VSplitLayout(
                    'settings',
                    'input_list',
                    'input_analysis',
                    sizes=[25, 200, 50],
                ),
                'input_recording_plot',
                sizes=[250, 900],
            ),
        )
        DockItem:
            name = 'settings'
            title = 'Settings'
            closable = False
            stretch = 0

            Conditional:
                condition << settings is None

                Container:
                    Label:
                        text = 'No inputs found on system. View mode only.'

            Conditional:
                condition << settings is not None

                Container:
                    layout_constraints => ():
                        # For some reason aligning right edge of first widget
                        # (label) does not produce nicely-aligned widgets, so we
                        # align the left edge of second widget.
                        widgets = self.visible_widgets()
                        second = [
                            w.visible_widgets()[1] for w in widgets
                            if isinstance(w, HGroup) and len(w.visible_widgets()) > 1
                        ]
                        constraints = [
                            vbox(
                                *widgets[:-1],
                                hbox(spacer(0), widgets[-1]),
                                spacing=5,
                            ),
                            align('left', *second),
                        ]

                        # One row per active slot: channel-select
                        # ObjectCombo + SensorView (type/instance/gain
                        # dropdowns). With only one slot there's nothing
                        # to align *to*; with several, each row currently
                        # sizes independently, so the dropdowns don't
                        # line up down the page -- collect each column
                        # across every active row and align its width.
                        slot_rows = [
                            w.visible_widgets() for w in widgets
                            if isinstance(w, HGroup) and len(w.visible_widgets()) == 2
                            and isinstance(w.visible_widgets()[1], SensorView)
                        ]
                        if len(slot_rows) > 1:
                            channel_combos = [row[0] for row in slot_rows]
                            # Each SensorView here always has a
                            # MultiTypeSensorReference sensor (device_type
                            # always set) and show_label=False, so its own
                            # visible_widgets() always starts with
                            # type_select and ends with [gain_select,
                            # gain_unit_label] -- but what's in between
                            # varies by device_type: an instance combo
                            # for Meas./Generic Mic./Starship (4 widgets
                            # total), nothing for Unity (3), or a
                            # sensitivity field + "mV/Pa" label for
                            # Nominal (5). Index from each end rather than
                            # assuming a fixed shape, and only cross-row
                            # align the instance combo among rows that
                            # actually have one.
                            sensor_rows = [row[1].visible_widgets() for row in slot_rows]
                            type_combos = [r[0] for r in sensor_rows]
                            gain_combos = [r[-2] for r in sensor_rows]
                            instance_combos = [r[1] for r in sensor_rows if len(r) == 4]
                            constraints += [
                                align('width', *channel_combos),
                                align('width', *type_combos),
                                align('width', *gain_combos),
                            ]
                            if len(instance_combos) > 1:
                                constraints.append(align('width', *instance_combos))
                        return constraints

                    HGroup:
                        share_layout = True
                        align_widths = False
                        padding = 0
                        spacing = 5

                        Label:
                            text = 'Number of inputs'

                        ObjectCombo:
                            items << list(range(1, len(settings.available_inputs) + 1))
                            selected := settings.n_active_inputs

                    Looper:
                        # One row per active slot (0-based position,
                        # independent of hardware order). The channel
                        # dropdown itself doubles as the row's label --
                        # no separate "Input N" text. Each slot can point
                        # at any real channel (settings.channel_for_slot/
                        # assign_slot), e.g. slot 0 -> hardware channel
                        # "Ch 10", slot 1 -> "Ch 5". run_input_recording()
                        # rejects the same channel being assigned to two
                        # active slots (gain/calibration are properties of
                        # the physical channel, not of the slot, so two
                        # slots on one channel can't actually record
                        # independently different settings).
                        iterable << range(settings.n_active_inputs)

                        HGroup:
                            share_layout = True
                            align_widths = False
                            padding = 0
                            spacing = 5

                            # `settings.slot_channels` is read (not used)
                            # in both bindings below only so Enaml's
                            # dependency tracer -- which can't see the read
                            # inside channel_for_slot() -- re-evaluates them
                            # when this slot is reassigned. Without it the
                            # sensor picker kept showing the previous
                            # channel's sensor, so the newly picked channel
                            # never got one and Record stayed disabled (see
                            # InputRecordingSettings._readiness_tick).
                            ObjectCombo:
                                items << settings.available_inputs
                                selected << (
                                    settings.slot_channels is not None
                                    and settings.channel_for_slot(loop_item)
                                )
                                selected ::
                                    settings.assign_slot(loop_item, selected)
                                to_string = lambda m: m.input_label

                            SensorView:
                                sensor << (
                                    settings.slot_channels is not None
                                    and settings.channel_for_slot(loop_item).sensor
                                )
                                collection << input_tree.collection
                                show_label = False

                    GroupPathPicker:
                        plugin_settings = settings
                        subfolder = 'input-recording'
                        auto_source = 'Generator'
                        collection << input_tree.collection

                    HGroup:
                        share_layout = True
                        align_widths = False
                        padding = 0
                        spacing = 5

                        Label:
                            text = 'Generator'

                        Field:
                            text := settings.generator.name
                            placeholder = 'e.g. pistonphone, speaker'
                            # Sync to the model shortly after typing stops, not only on
                            # Enter/focus loss, so Record enables as soon as
                            # something has been typed.
                            submit_triggers = ['lost_focus', 'return_pressed', 'auto_sync']

                    PushButton: start:
                        text = 'Record'
                        # `settings._readiness_tick` is read (not used) only
                        # so Enaml's dependency tracer -- which can't see
                        # through a method call or the comprehensions that
                        # used to live here -- re-evaluates this binding
                        # whenever slot/sensor/generator state changes (see
                        # InputRecordingSettings._readiness_tick).
                        enabled << (
                            settings._readiness_tick >= 0
                            and settings.ready_to_record()
                        )
                        clicked ::
                            # `enabled` above should normally keep this
                            # unreachable, but don't rely on that alone --
                            # run_input_recording() raises ValueError on
                            # invalid state (e.g. a duplicate-channel
                            # assignment slipping through) and LookupError
                            # if a selected channel's reference calibration
                            # hasn't been pinned as current (see
                            # CalibratedObject.get_current_calibration),
                            # and neither must fail silently. (Enaml
                            # notification blocks disallow a bare `return`,
                            # hence try/except/else rather than an early
                            # exit.)
                            try:
                                settings.run_input_recording()
                            except (ValueError, LookupError) as exc:
                                warning(self, 'Cannot record', str(exc))
                            else:
                                input_tree.collection.update_groups()

        DockItem:
            name = 'input_recording_plot'
            title = 'Input Recording'
            closable = False
            stretch = 10

            Container:
                Container: toolbar:
                    padding = 0
                    # Filter settings on the left; the region's Play and
                    # Export buttons at the right end.
                    constraints = [
                        hbox(filter_row, spacer, play_button, export_button),
                        align('v_center', filter_row, play_button, export_button),
                    ]

                    PushButton: play_button:
                        text << 'Stop' if player.playing else 'Play region'
                        enabled << player.playing or has_region(
                            input_recording_plot.manager.analysis)
                        clicked ::
                            play_selected_region()

                    PushButton: export_button:
                        text = 'Export region\u2026'
                        enabled << has_region(input_recording_plot.manager.analysis)
                        clicked ::
                            export_selected_region()

                    HGroup: filter_row:
                        align_widths = False
                        Label:
                            text = 'Filter'
                        ObjectCombo:
                            items = ['High-pass', 'Unfiltered', 'dBA', 'Band-pass']
                            selected := input_recording_plot.manager.filter_mode

                        Conditional:
                            condition << input_recording_plot.manager.filter_mode == 'High-pass'

                            Label:
                                text = 'Cutoff'
                            FloatField:
                                value := input_recording_plot.manager.highpass_fc
                            Label:
                                text = 'Hz, order'
                            IntField:
                                value := input_recording_plot.manager.highpass_order

                        Conditional:
                            condition << input_recording_plot.manager.filter_mode == 'Band-pass'

                            Label:
                                text = 'Center freq.'
                            FloatField:
                                value := input_recording_plot.manager.filter_fc
                            Label:
                                text = 'Hz, width'
                            ObjectCombo:
                                items = list(BANDWIDTHS)
                                to_string = lambda octaves: BANDWIDTHS[octaves]
                                selected := input_recording_plot.manager.filter_bw
                            Label:
                                text = 'octaves, order'
                            IntField:
                                value := input_recording_plot.manager.filter_order

                        CheckBox:
                            text = 'Zero-phase'
                            checked := input_recording_plot.manager.zero_phase
                            tool_tip = (
                                'Apply the filter with no phase shift: same levels, '
                                'but the waveform is not delayed or reshaped.\n'
                                'Off: filter as an analog filter would (phase shift '
                                'and all). Also applies to the dBA row.'
                            )
                        CheckBox:
                            text = 'Exact A-weighting'
                            checked := input_recording_plot.manager.exact_a_weighting
                            tool_tip = (
                                'A-weight with the exact IEC 61672-1 curve, applied '
                                'in the frequency domain.\nOff: a digital (bilinear) '
                                'approximation that falls short near Nyquist at '
                                '44.1/48 kHz. Applies to the dBA filter and row.'
                            )

                PGCanvas: input_recording_plot:
                    attr manager = InputRecordingPlotManager(apply_calibration=True)
                    component << manager.component

        DockItem:
            name = 'input_list'
            title = 'Recordings'
            closable = False
            stretch = 0

            CalibratedObjects: input_tree:
                mapping = {
                    'Name': {
                        'groupby': True,
                        'id': True,
                        'to_str': lambda x: x.name,
                    },
                    'Date': {
                        'groupby': False,
                        'id': True,
                        'to_str': lambda x: str(x.datetime),
                    },
                    'Generator': {
                        'to_str': lambda x: x.generator,
                    },
                    'Channel': {
                        'to_str': lambda x: ', '.join(
                            v['label'] for v in x.sensors.values()
                        ),
                    },
                    'Sensor': {
                        'to_str': lambda x: ', '.join(
                            v['sensor'] for v in x.sensors.values()
                        ),
                    },
                    'Gain': {
                        'to_str': lambda x: ', '.join(
                            f'{v["gain"]:g} dB' for v in x.sensors.values()
                            if 'gain' in v
                        ),
                    },
                }

                collection = ObjectCollection(
                    input_recording_manager,
                    [input_recording_plot.manager],
                )

        DockItem:
            name = 'input_analysis'
            title = 'Analysis'
            closable = False

            Container:
                ListDictTable: analysis_table:
                    # Transposed: a row per measurement, a column per
                    # recorded channel (see transpose_analysis).
                    attr layout << transpose_analysis(
                        input_recording_plot.manager.analysis)
                    stretch_last_section = False
                    # The columns change as recordings are ticked, so
                    # there's no fixed order to drag them into.
                    columns_movable = False
                    # Wide enough for each header's channel and date.
                    header_resize_mode = 'contents'
                    data << layout[0]
                    column_info << layout[1]

                    get_row_label => (row_index):
                        return ANALYSIS_ROWS[row_index][1]

                    get_cell_color => (row, column):
                        if row != 0:
                            return 'white'
                        return input_recording_plot.manager.analysis[column]['color']
